function days_in_month_spec [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ext_chrono/civil_naive_date.rs" 32 8 32 63] (year: Int32.t) (month: UInt32.t) : UInt32.t
 = [%#scivil_naive_date'10] if month = (2: UInt32.t) then
    if is_leap_year year then (29: UInt32.t) else (28: UInt32.t)
  else
    if month = (4: UInt32.t) \/ month = (6: UInt32.t) \/ month = (9: UInt32.t) \/ month = (11: UInt32.t) then
      (30: UInt32.t)
    else
      if ge_log_u32 month (1: UInt32.t) /\ UInt32.le month (12: UInt32.t) then (31: UInt32.t) else (0: UInt32.t)
  


