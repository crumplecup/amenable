use creusot.int.Int64
use creusot.prelude.Any

type tup2_i64_i64 = { f0: Int64.t; f1: Int64.t }

predicate ge_log_i64 [@inline:trivial] (self: Int64.t) (other: Int64.t) = [%#sord] Int64.le other self

meta "rewrite_def" predicate ge_log_i64

predicate iso_week_round_trip_model_inputs_valid [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ext_chrono/iso_week.rs" 61 8 67 17] (day_count: Int64.t) (m1: Int64.t) (weekday: Int64.t) (back_weeks: Int64.t) (weeks_in_year: Int64.t) =
  [%#siso_week'7] ge_log_i64 weekday (0: Int64.t)
  /\ Int64.le weekday (6: Int64.t)
  /\ ge_log_i64 back_weeks (0: Int64.t)
  /\ Int64.lt back_weeks weeks_in_year
  /\ (weeks_in_year = (52: Int64.t) \/ weeks_in_year = (53: Int64.t))
  /\ day_count = Int64.add (Int64.add m1 (Int64.mul back_weeks (7: Int64.t))) weekday
  /\ ge_log_i64 day_count (Int64.neg (100000000: Int64.t))
  /\ Int64.le day_count (100000000: Int64.t)
  /\ ge_log_i64 m1 (Int64.neg (100000000: Int64.t)) /\ Int64.le m1 (100000000: Int64.t)

predicate iso_week_round_trip_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ext_chrono/iso_week.rs" 37 8 41 17] (week_number: Int64.t) (rebuilt_day_count: Int64.t) (day_count: Int64.t) =
  [%#siso_week'8] ge_log_i64 week_number (1: Int64.t)
  /\ Int64.le week_number (53: Int64.t) /\ rebuilt_day_count = day_count

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let verify_iso_week_round_trips_model [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ext_chrono/iso_week.rs" 98 8 104 23]
  (day_count: Int64.t) (m1: Int64.t) (weekday: Int64.t) (back_weeks: Int64.t) (weeks_in_year: Int64.t)
  (return (x: tup2_i64_i64)) =
{[@stop_split] [@expl:verify_iso_week_round_trips_model requires] [%#siso_week'5] iso_week_round_trip_model_inputs_valid day_count m1 weekday back_weeks weeks_in_year}
  (! bb0
  [ bb0 = s0
    [ s0 = Int64.add [%#siso_week'0] {back_weeks} {[%#siso_week] (1: Int64.t)}
        (fun (_x: Int64.t) -> [ &week_number <- _x ] s1)
    | s1 = Int64.mul [%#siso_week'2] {back_weeks} {[%#siso_week'1] (7: Int64.t)}
        (fun (_x: Int64.t) -> [ &_19 <- _x ] s2)
    | s2 = Int64.add [%#siso_week'3] {m1} {_19} (fun (_x: Int64.t) -> [ &_17 <- _x ] s3)
    | s3 = Int64.add [%#siso_week'4] {_17} {weekday} (fun (_x: Int64.t) -> [ &rebuilt <- _x ] s4)
    | s4 = [ &_ret <- { f0 = week_number; f1 = rebuilt } ] s5
    | s5 = return {_ret} ] ]
  [ & _ret: tup2_i64_i64 = Any.any_l ()
  | & m1: Int64.t = m1
  | & weekday: Int64.t = weekday
  | & back_weeks: Int64.t = back_weeks
  | & week_number: Int64.t = Any.any_l ()
  | & rebuilt: Int64.t = Any.any_l ()
  | & _17: Int64.t = Any.any_l ()
  | & _19: Int64.t = Any.any_l () ])
  [ return (result: tup2_i64_i64) ->
  {[@stop_split] [@expl:verify_iso_week_round_trips_model ensures] [%#siso_week'6] iso_week_round_trip_holds result.f0 result.f1 day_count}
    (! return {result}) ]
