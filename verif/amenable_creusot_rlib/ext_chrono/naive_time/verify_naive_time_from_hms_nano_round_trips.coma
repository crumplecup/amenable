let from_hms_nano_opt (hour: UInt32.t) (minute: UInt32.t) (second: UInt32.t) (nano: UInt32.t)
  (return (x: t_Option_NaiveTime)) = any
  [ return (result: t_Option_NaiveTime) ->
  {[@stop_split] [@expl:from_hms_nano_opt ensures] ([@stop_split] [@expl:from_hms_nano_opt result type invariant] [%#smod] inv_Option_NaiveTime result)
    /\ ([@stop_split] [@expl:from_hms_nano_opt ensures] [%#slogic] match result with
      | Some t -> UInt32.lt hour (24: UInt32.t)
      /\ UInt32.lt minute (60: UInt32.t)
      /\ UInt32.lt second (60: UInt32.t)
      /\ UInt32.lt nano (2000000000: UInt32.t)
      /\ (UInt32.lt nano (1000000000: UInt32.t) \/ second = (59: UInt32.t))
      /\ naive_time_hour_value t = hour
      /\ naive_time_minute_value t = minute
      /\ naive_time_second_value t = second /\ naive_time_nanosecond_value t = nano
      | None -> not (UInt32.lt hour (24: UInt32.t)
      /\ UInt32.lt minute (60: UInt32.t)
      /\ UInt32.lt second (60: UInt32.t)
      /\ UInt32.lt nano (2000000000: UInt32.t) /\ (UInt32.lt nano (1000000000: UInt32.t) \/ second = (59: UInt32.t)))
      end)}
    (! return {result}) ]

