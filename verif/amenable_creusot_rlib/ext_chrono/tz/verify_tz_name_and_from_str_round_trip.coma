function tz_name [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ext_chrono/shared_trusted_accessors.rs" 125 0 125 63] (_t: t_Tz) : string

let name (self: t_Tz) (return (x: string)) = any
  [ return (result: string) -> {[@stop_split] [@expl:name ensures] [%#slogic] result = tz_name self}
    (! return {result}) ]

type t_ParseError

type t_Result_Tz_ParseError = Ok t_Tz | Err t_ParseError

predicate inv_ParseError (_1: t_ParseError)

predicate inv_Result_Tz_ParseError (_1: t_Result_Tz_ParseError)

axiom inv_axiom [@rewrite]: forall _1: t_Result_Tz_ParseError [inv_Result_Tz_ParseError _1]. inv_Result_Tz_ParseError _1
    = match _1 with
      | Ok f0 -> true
      | Err f0 -> inv_ParseError f0
      end

let from_str_Tz (s: string) (return (x: t_Result_Tz_ParseError)) = any
  [ return (result: t_Result_Tz_ParseError) ->
  {[@stop_split] [@expl:from_str_Tz ensures] ([@stop_split] [@expl:from_str result type invariant] [%#stimezones] inv_Result_Tz_ParseError result)
    /\ ([@stop_split] [@expl:from_str ensures] [%#slogic'0] match result with
      | Ok t -> s = tz_name t
      | Err _ -> forall t: t_Tz. s <> tz_name t
      end)}
    (! return {result}) ]

let elim_Ok (_x: t_Result_Tz_ParseError) (return (f0: t_Tz)) = any
  [ _k (f0: t_Tz) -> {Ok f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Ok] match _x with
      | Ok _ -> true
      | _ -> false
      end}
    any) ]

function deep_model_str (self: string) : Seq.seq Char.t

function deep_model_ref_str [@inline:trivial] (self: string) : Seq.seq Char.t = [%#smodel] deep_model_str self

meta "rewrite_def" function deep_model_ref_str

function deep_model_ref_ref_str [@inline:trivial] (self: string) : Seq.seq Char.t = [%#smodel] deep_model_ref_str self

meta "rewrite_def" function deep_model_ref_ref_str

let eq_ref_str (self: string) (other: string) (return (x: bool)) = any
  [ return (result: bool) -> {[@stop_split] [@expl:eq ensures] [%#scmp] result
    = (deep_model_ref_ref_str self = deep_model_ref_ref_str other)}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

