use creusot.int.Int16
use creusot.int.Int8
use creusot.prelude.Any

type t_Date

type t_Error

type t_Result_Date_Error = Ok t_Date | Err t_Error

predicate inv_Date (_1: t_Date)

predicate inv_Error (_1: t_Error)

predicate inv_Result_Date_Error (_1: t_Result_Date_Error)

axiom inv_axiom [@rewrite]: forall x: t_Result_Date_Error [inv_Result_Date_Error x]. inv_Result_Date_Error x
    = match x with
      | Ok f0 -> inv_Date f0
      | Err f0 -> inv_Error f0
      end

function date_year_value [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ext_jiff/civil_date.rs" 43 0 43 60] (_d: t_Date) : Int16.t

function date_month_value [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ext_jiff/civil_date.rs" 50 0 50 60] (_d: t_Date) : Int8.t

function date_day_value [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ext_jiff/civil_date.rs" 57 0 57 58] (_d: t_Date) : Int8.t

predicate gt_log_i16 [@inline:trivial] (self: Int16.t) (other: Int16.t) = [%#sord] Int16.lt other self

meta "rewrite_def" predicate gt_log_i16

predicate gt_log_i8 [@inline:trivial] (self: Int8.t) (other: Int8.t) = [%#sord] Int8.lt other self

meta "rewrite_def" predicate gt_log_i8

let new (year: Int16.t) (month: Int8.t) (day: Int8.t) (return (x: t_Result_Date_Error)) = any
  [ return (result: t_Result_Date_Error) ->
  {[@stop_split] [@expl:new ensures] ([@stop_split] [@expl:new result type invariant] [%#sdate] inv_Result_Date_Error result)
    /\ ([@stop_split] [@expl:new ensures] [%#scivil_date] match result with
      | Ok d -> date_year_value d = year /\ date_month_value d = month /\ date_day_value d = day
      | Err _ -> Int16.lt year (Int16.neg (9999: Int16.t))
      \/ gt_log_i16 year (9999: Int16.t)
      \/ Int8.lt month (1: Int8.t)
      \/ gt_log_i8 month (12: Int8.t) \/ Int8.lt day (1: Int8.t) \/ gt_log_i8 day (28: Int8.t)
      end)}
    (! return {result}) ]

let expect_Date (self_: t_Result_Date_Error) (msg: string) (return (x: t_Date)) =
{[@stop_split] [@expl:expect_Date requires] ([@stop_split] [@expl:expect 'self_' type invariant] [%#sresult] inv_Result_Date_Error self_)
  /\ ([@stop_split] [@expl:expect requires] [%#sresult'0] exists t: t_Date. self_ = Ok t)}
  any
  [ return (result: t_Date) ->
  {[@stop_split] [@expl:expect_Date ensures] ([@stop_split] [@expl:expect result type invariant] inv_Date result)
    /\ ([@stop_split] [@expl:expect ensures] [%#sresult'1] Ok result = self_)}
    (! return {result}) ]

type t_Era = BCE | CE

type tup2_i16_Era = { f0: Int16.t; f1: t_Era }

predicate ge_log_i16 [@inline:trivial] (self: Int16.t) (other: Int16.t) = [%#sord'0] Int16.le other self

meta "rewrite_def" predicate ge_log_i16

function era_discriminant [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ext_jiff/civil_era.rs" 67 0 67 52] (_e: t_Era) : Int8.t

let era_year (self_: t_Date) (return (x: tup2_i16_Era)) =
{[@stop_split] [@expl:era_year 'self_' type invariant] [%#scivil_era'7] inv_Date self_}
  any
  [ return (result: tup2_i16_Era) ->
  {[@stop_split] [@expl:era_year ensures] [%#scivil_era'8] if ge_log_i16 (date_year_value self_) (1: Int16.t) then
      result.f0 = date_year_value self_ /\ era_discriminant result.f1 = (1: Int8.t)
    else
      result.f0 = Int16.add (Int16.neg (date_year_value self_)) (1: Int16.t) /\ era_discriminant result.f1 = (0: Int8.t)
    }
    (! return {result}) ]

predicate civil_era_year_classifies_bce_and_ce_correctly [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ext_jiff/civil_era.rs" 94 8 97 17] (year: Int16.t) (observed: tup2_i16_Era) =
  [%#scivil_era'9] if ge_log_i16 year (1: Int16.t) then
    observed.f0 = year /\ era_discriminant observed.f1 = (1: Int8.t)
  else
    observed.f0 = Int16.add (Int16.neg year) (1: Int16.t) /\ era_discriminant observed.f1 = (0: Int8.t)


