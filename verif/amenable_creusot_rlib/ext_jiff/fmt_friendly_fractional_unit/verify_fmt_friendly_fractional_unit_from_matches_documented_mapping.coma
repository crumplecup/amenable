        | _ -> false
        end
      | Minute -> match result with
        | Minute'0 -> true
        | _ -> false
        end
      | Second -> match result with
        | Second'0 -> true
        | _ -> false
        end
      | Millisecond -> match result with
        | Millisecond'0 -> true
        | _ -> false
        end
      | Microsecond -> match result with
        | Microsecond'0 -> true
        | _ -> false
        end
      | _ -> true
      end}
    (! return {result}) ]

