type t_FractionalUnit = Hour | Minute | Second | Millisecond | Microsecond

type t_Unit =
  | Year'0
  | Month'0
  | Week'0
  | Day'0
  | Hour'0
  | Minute'0
  | Second'0
  | Millisecond'0
  | Microsecond'0
  | Nanosecond'0

