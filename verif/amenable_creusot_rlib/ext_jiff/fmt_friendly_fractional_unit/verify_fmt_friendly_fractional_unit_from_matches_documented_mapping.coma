meta "rewrite_def" predicate precondition_from

let from_Unit (u: t_FractionalUnit) (return (x: t_Unit)) = any
  [ return (result: t_Unit) -> {[@stop_split] [@expl:from ensures] [%#sfmt_friendly_fractional_unit'3] match u with
      | Hour -> match result with
