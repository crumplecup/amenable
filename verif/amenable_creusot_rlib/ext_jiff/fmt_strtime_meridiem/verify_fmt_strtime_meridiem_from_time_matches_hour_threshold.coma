use creusot.int.Int8
use creusot.int.Int32
use creusot.prelude.Any

type t_Time

type t_Error

type t_Result_Time_Error = Ok t_Time | Err t_Error

predicate inv_Time (_1: t_Time)

predicate inv_Error (_1: t_Error)

predicate inv_Result_Time_Error (_1: t_Result_Time_Error)

axiom inv_axiom [@rewrite]: forall x: t_Result_Time_Error [inv_Result_Time_Error x]. inv_Result_Time_Error x
    = match x with
      | Ok f0 -> inv_Time f0
      | Err f0 -> inv_Error f0
      end

function civil_time_hour_value [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ext_jiff/civil_time.rs" 33 0 33 65] (_t: t_Time) : Int8.t

function civil_time_minute_value [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ext_jiff/civil_time.rs" 40 0 40 67] (_t: t_Time) : Int8.t

function civil_time_second_value [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ext_jiff/civil_time.rs" 47 0 47 67] (_t: t_Time) : Int8.t

function civil_time_subsec_nanosecond_value [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ext_jiff/civil_time.rs" 54 0 54 79] (_t: t_Time) : Int32.t

predicate gt_log_i8 [@inline:trivial] (self: Int8.t) (other: Int8.t) = [%#sord] Int8.lt other self

meta "rewrite_def" predicate gt_log_i8

predicate gt_log_i32 [@inline:trivial] (self: Int32.t) (other: Int32.t) = [%#sord] Int32.lt other self

meta "rewrite_def" predicate gt_log_i32

let new (hour: Int8.t) (minute: Int8.t) (second: Int8.t) (subsec_nanosecond: Int32.t)
  (return (x: t_Result_Time_Error)) = any
  [ return (result: t_Result_Time_Error) ->
  {[@stop_split] [@expl:new ensures] ([@stop_split] [@expl:new result type invariant] [%#stime] inv_Result_Time_Error result)
    /\ ([@stop_split] [@expl:new ensures] [%#scivil_time] match result with
      | Ok t -> civil_time_hour_value t = hour
      /\ civil_time_minute_value t = minute
      /\ civil_time_second_value t = second /\ civil_time_subsec_nanosecond_value t = subsec_nanosecond
      | Err _ -> Int8.lt hour (0: Int8.t)
      \/ gt_log_i8 hour (23: Int8.t)
      \/ Int8.lt minute (0: Int8.t)
      \/ gt_log_i8 minute (59: Int8.t)
      \/ Int8.lt second (0: Int8.t)
      \/ gt_log_i8 second (59: Int8.t)
      \/ Int32.lt subsec_nanosecond (0: Int32.t) \/ gt_log_i32 subsec_nanosecond (999999999: Int32.t)
      end)}
    (! return {result}) ]

let expect_Time (self_: t_Result_Time_Error) (msg: string) (return (x: t_Time)) =
{[@stop_split] [@expl:expect_Time requires] ([@stop_split] [@expl:expect 'self_' type invariant] [%#sresult] inv_Result_Time_Error self_)
  /\ ([@stop_split] [@expl:expect requires] [%#sresult'0] exists t: t_Time. self_ = Ok t)}
  any
  [ return (result: t_Time) ->
  {[@stop_split] [@expl:expect_Time ensures] ([@stop_split] [@expl:expect result type invariant] inv_Time result)
    /\ ([@stop_split] [@expl:expect ensures] [%#sresult'1] Ok result = self_)}
    (! return {result}) ]

type t_Meridiem = AM | PM

predicate precondition_from (self: ()) (args: t_Time) = [%#smod] let t = args in [%#sfmt_strtime_meridiem'14] inv_Time t

meta "rewrite_def" predicate precondition_from

predicate ge_log_i8 [@inline:trivial] (self: Int8.t) (other: Int8.t) = [%#sord'0] Int8.le other self

meta "rewrite_def" predicate ge_log_i8

let from_Meridiem (t: t_Time) (return (x: t_Meridiem)) =
{[@stop_split] [@expl:from 't' type invariant] [%#sfmt_strtime_meridiem'14] inv_Time t}
  any
  [ return (result: t_Meridiem) -> {[@stop_split] [@expl:from ensures] [%#sfmt_strtime_meridiem'15] match result with
      | AM -> Int8.lt (civil_time_hour_value t) (12: Int8.t)
      | PM -> ge_log_i8 (civil_time_hour_value t) (12: Int8.t)
      end}
    (! return {result}) ]

predicate postcondition_from (self: ()) (args: t_Time) (result: t_Meridiem) =
  [%#smod] let t = args in [%#sfmt_strtime_meridiem'15] match result with
    | AM -> Int8.lt (civil_time_hour_value t) (12: Int8.t)
    | PM -> ge_log_i8 (civil_time_hour_value t) (12: Int8.t)
    end

meta "rewrite_def" predicate postcondition_from

let into_Time (self_: t_Time) (return (x: t_Meridiem)) =
{[@stop_split] [@expl:into_Time requires] ([@stop_split] [@expl:into 'self_' type invariant] [%#sconvert] inv_Time self_)
  /\ ([@stop_split] [@expl:into requires] [%#sconvert'0] precondition_from () self_)}
  any
  [ return (result: t_Meridiem) ->
  {[@stop_split] [@expl:into ensures] [%#sconvert'1] postcondition_from () self_ result}
    (! return {result}) ]

predicate fmt_strtime_meridiem_from_time_matches_hour_threshold_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ext_jiff/fmt_strtime_meridiem.rs" 55 8 55 93] (matches: bool) =
  [%#sfmt_strtime_meridiem'13] matches

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let verify_fmt_strtime_meridiem_from_time_matches_hour_threshold [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ext_jiff/fmt_strtime_meridiem.rs" 69 8 69 89]
  (hour: Int8.t) (return (x: bool)) = (! bb0
  [ bb0 = s0
    [ s0 = [ &_4 <- Int8.lt hour ([%#sfmt_strtime_meridiem] (0: Int8.t)) ] s1
    | s1 = any [ br0 -> {_4 = false} (! bb2) | br1 -> {_4} (! bb4) ] ]
  | bb2 = s0
    [ s0 = [ &_6 <- Int8.gt hour ([%#sfmt_strtime_meridiem'0] (23: Int8.t)) ] s1
    | s1 = any [ br0 -> {_6 = false} (! bb5) | br1 -> {_6} (! bb4) ] ]
  | bb4 = s0 [ s0 = [ &_ret <- [%#sfmt_strtime_meridiem'1] true ] s1 | s1 = return {_ret} ]
  | bb5 = s0
    [ s0 = new [%#sfmt_strtime_meridiem'5] {hour} {[%#sfmt_strtime_meridiem'2] (0: Int8.t)}
        {[%#sfmt_strtime_meridiem'3] (0: Int8.t)} {[%#sfmt_strtime_meridiem'4] (0: Int32.t)}
        (fun (_x: t_Result_Time_Error) -> [ &_9 <- _x ] s1)
    | s1 = [ &_12 <- [%#sfmt_strtime_meridiem'6] "hour is already checked to be in civil::Time's valid range" ] s2
    | s2 = expect_Time [%#sfmt_strtime_meridiem'7] {_9} {_12} (fun (_x: t_Time) -> [ &t <- _x ] s3)
    | s3 = into_Time [%#sfmt_strtime_meridiem'8] {t} (fun (_x: t_Meridiem) -> [ &meridiem <- _x ] s4)
    | s4 = any [ br0 -> {meridiem = AM} (! bb12) | br1 -> {meridiem = PM} (! bb11) ] ]
  | bb11 = s0 [ s0 = [ &_ret <- Int8.ge hour ([%#sfmt_strtime_meridiem'9] (12: Int8.t)) ] s1 | s1 = return {_ret} ]
  | bb12 = s0 [ s0 = [ &_ret <- Int8.lt hour ([%#sfmt_strtime_meridiem'10] (12: Int8.t)) ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l ()
  | & hour: Int8.t = hour
  | & _4: bool = Any.any_l ()
  | & _6: bool = Any.any_l ()
  | & t: t_Time = Any.any_l ()
  | & _9: t_Result_Time_Error = Any.any_l ()
  | & _12: string = Any.any_l ()
  | & meridiem: t_Meridiem = Any.any_l () ])
  [ return (result: bool) ->
  {[@stop_split] [@expl:verify_fmt_strtime_meridiem_from_time_matches_hour_threshold ensures] [%#sfmt_strtime_meridiem'12] fmt_strtime_meridiem_from_time_matches_hour_threshold_holds result}
    (! return {result}) ]
