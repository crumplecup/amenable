let%span sledger = "/home/erik/repos/amenable/crates/amenable_creusot/src/ledger.rs" 789 12 789 26
let%span sledger'0 = "/home/erik/repos/amenable/crates/amenable_creusot/src/ledger.rs" 789 30 789 31
let%span sledger'1 = "/home/erik/repos/amenable/crates/amenable_creusot/src/ledger.rs" 784 19 784 30
let%span sledger'2 = "/home/erik/repos/amenable/crates/amenable_creusot/src/ledger.rs" 785 18 785 65
let%span sledger'3 = "/home/erik/repos/amenable/crates/amenable_creusot/src/ledger.rs" 749 24 749 58

use creusot.int.Int64
use creusot.prelude.Any
use int.Int

predicate balanced_entries_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ledger.rs" 748 8 748 85] (debit: Int64.t) (credit: Int64.t) (outcome: bool) =
  [%#sledger'3] outcome = (Int64.to_int debit + Int64.to_int credit = 0)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let rec check_commit_balances [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ledger.rs" 786 8 786 53]
  (amount: Int64.t) (return (x: bool)) =
  {[@stop_split] [@expl:check_commit_balances requires] [%#sledger'1] Int64.to_int amount > 0}
  (! bb0
  [ bb0 = s0
    [ s0 = Int64.neg {amount} (fun (_x: Int64.t) -> [ &debit <- _x ] s1)
    | s1 = [ &credit <- amount ] s2
    | s2 = Int64.add [%#sledger] {debit} {credit} (fun (_x: Int64.t) -> [ &_9 <- _x ] s3)
    | s3 = [ &_ret <- _9 = ([%#sledger'0] (0: Int64.t)) ] s4
    | s4 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l ()
  | & amount: Int64.t = amount
  | & debit: Int64.t = Any.any_l ()
  | & credit: Int64.t = Any.any_l ()
  | & _9: Int64.t = Any.any_l () ])
  [ return (result: bool) ->
  {[@stop_split] [@expl:check_commit_balances ensures] [%#sledger'2] balanced_entries_holds (Int64.neg amount) amount result}
    (! return {result}) ]
