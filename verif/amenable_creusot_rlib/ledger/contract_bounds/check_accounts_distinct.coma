let rec check_accounts_distinct
  [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ledger/contract_bounds.rs" 171 8 171 62] (from: UInt64.t)
  (to': UInt64.t) (return (x: bool)) = (! bb0
