predicate accounts_distinct_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ledger/contract_bounds.rs" 148 8 148 81] (from: UInt64.t) (to': UInt64.t) (outcome: bool) =
  [%#scontract_bounds'1] outcome = (from <> to')

