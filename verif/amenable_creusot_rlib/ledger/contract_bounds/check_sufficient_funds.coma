let%span scontract_bounds = "/home/erik/repos/amenable/crates/amenable_creusot/src/ledger/contract_bounds.rs" 137 19 137 23
let%span scontract_bounds'0 = "/home/erik/repos/amenable/crates/amenable_creusot/src/ledger/contract_bounds.rs" 138 18 138 65
let%span scontract_bounds'1 = "/home/erik/repos/amenable/crates/amenable_creusot/src/ledger/contract_bounds.rs" 118 24 118 56
let%span sord = "/home/erik/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/creusot-std-0.13.0/src/logic/ord.rs" 34 8 34 21

use creusot.int.Int64
use creusot.prelude.Any
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate sufficient_funds_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ledger/contract_bounds.rs" 117 8 117 87] (balance: Int64.t) (amount: Int64.t) (outcome: bool) =
  [%#scontract_bounds'1] outcome = ge_log_Int (Int64.to_int balance) (Int64.to_int amount)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let check_sufficient_funds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ledger/contract_bounds.rs" 139 8 139 68]
  (balance: Int64.t) (amount: Int64.t) (return (x: bool)) = (! bb0
  [ bb0 = s0 [ s0 = [ &_ret <- Int64.ge balance amount ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l () | & balance: Int64.t = balance | & amount: Int64.t = amount ])
  [ return (result: bool) ->
  {[@stop_split] [@expl:check_sufficient_funds ensures] [%#scontract_bounds'0] sufficient_funds_holds balance amount result}
    (! return {result}) ]
