use creusot.int.Int64
use creusot.int.UInt64
use creusot.prelude.Any
use int.Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

predicate amount_positive_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ledger/ledger_validate.rs" 252 8 252 72] (amount: Int64.t) (outcome: bool) =
  [%#sledger_validate'1] outcome = gt_log_Int (Int64.to_int amount) 0

let check_amount_positive (amount: Int64.t) (return (x: bool)) = any
  [ return (result: bool) ->
  {[@stop_split] [@expl:check_amount_positive ensures] [%#sledger_validate'0] amount_positive_holds amount result}
    (! return {result}) ]

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate sufficient_funds_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ledger/contract_bounds.rs" 117 8 117 87] (balance: Int64.t) (amount: Int64.t) (outcome: bool) =
  [%#scontract_bounds'9] outcome = ge_log_Int (Int64.to_int balance) (Int64.to_int amount)

let check_sufficient_funds (balance: Int64.t) (amount: Int64.t) (return (x: bool)) = any
  [ return (result: bool) ->
  {[@stop_split] [@expl:check_sufficient_funds ensures] [%#scontract_bounds'5] sufficient_funds_holds balance amount result}
    (! return {result}) ]

predicate accounts_distinct_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ledger/contract_bounds.rs" 152 8 152 81] (from: UInt64.t) (to': UInt64.t) (outcome: bool) =
  [%#scontract_bounds'10] outcome = (from <> to')

let check_accounts_distinct (from: UInt64.t) (to': UInt64.t) (return (x: bool)) = any
  [ return (result: bool) ->
  {[@stop_split] [@expl:check_accounts_distinct ensures] [%#scontract_bounds'7] accounts_distinct_holds from to' result}
    (! return {result}) ]

type t_TransferOutcome = Ok | NegativeAmount Int64.t | InsufficientFunds Int64.t Int64.t | SameAccount

predicate validated_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ledger/contract_bounds.rs" 215 8 215 93] (amount: Int64.t) (from: UInt64.t) (to': UInt64.t) (outcome: t_TransferOutcome) =
  [%#scontract_bounds'8] match outcome with
    | Ok -> amount_positive_holds amount true /\ accounts_distinct_holds from to' true
    | NegativeAmount bad -> bad = amount /\ Int64.to_int amount <= 0
    | InsufficientFunds balance required -> Int64.lt balance required
    | SameAccount -> true
    end

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let validate [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ledger/contract_bounds.rs" 245 8 245 85]
  (balance: Int64.t) (amount: Int64.t) (from: UInt64.t) (to': UInt64.t) (return (x: t_TransferOutcome)) = (! bb0
  [ bb0 = s0
    [ s0 = check_amount_positive [%#scontract_bounds] {amount} (fun (_x: bool) -> [ &_11 <- _x ] s1)
    | s1 = any [ br0 -> {_11 = false} (! bb3) | br1 -> {_11} (! bb2) ] ]
  | bb2 = s0
    [ s0 = check_sufficient_funds [%#scontract_bounds'0] {balance} {amount} (fun (_x: bool) -> [ &_16 <- _x ] s1)
    | s1 = any [ br0 -> {_16 = false} (! bb6) | br1 -> {_16} (! bb5) ] ]
  | bb5 = s0
    [ s0 = check_accounts_distinct [%#scontract_bounds'1] {from} {to'} (fun (_x: bool) -> [ &_23 <- _x ] s1)
    | s1 = any [ br0 -> {_23 = false} (! bb9) | br1 -> {_23} (! bb8) ] ]
  | bb8 = s0 [ s0 = [ &_ret <- Ok ] s1 | s1 = return {_ret} ]
  | bb9 = s0 [ s0 = [ &_ret <- SameAccount ] s1 | s1 = return {_ret} ]
  | bb6 = s0 [ s0 = [ &_ret <- InsufficientFunds balance amount ] s1 | s1 = return {_ret} ]
  | bb3 = s0 [ s0 = [ &_ret <- NegativeAmount amount ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_TransferOutcome = Any.any_l ()
  | & balance: Int64.t = balance
  | & amount: Int64.t = amount
  | & from: UInt64.t = from
  | & to': UInt64.t = to'
  | & _11: bool = Any.any_l ()
  | & _16: bool = Any.any_l ()
  | & _23: bool = Any.any_l () ])
  [ return (result: t_TransferOutcome) ->
  {[@stop_split] [@expl:validate ensures] [%#scontract_bounds'3] validated_holds amount from to' result}
    (! return {result}) ]
