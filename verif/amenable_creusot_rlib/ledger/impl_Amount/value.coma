use creusot.int.Int64
use creusot.prelude.Any

type t_Amount = { f0: Int64.t }

predicate amount_value_matches_field [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ledger.rs" 255 8 255 76] (observed: Int64.t) (field: Int64.t) =
  [%#sledger'1] observed = field

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let rec value [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ledger.rs" 317 4 317 26] (self: t_Amount)
  (return (x: Int64.t)) = (! bb0
  [ bb0 = s0 [ s0 = [ &_ret <- self.f0 ] s1 | s1 = return {_ret} ] ]
  [ & _ret: Int64.t = Any.any_l () | & self: t_Amount = self ])
