use creusot.int.Int64
use creusot.prelude.Any
use int.Int

type t_Ledger = { balance: Int64.t }

type tup2_i64_i64 = { f0: Int64.t; f1: Int64.t }

type t_Result_unit_tup2_i64_i64 = Ok () | Err tup2_i64_i64

predicate sufficient_funds_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ledger.rs" 604 8 604 87] (balance'0: Int64.t) (amount: Int64.t) (outcome: bool) =
  [%#sledger'1] outcome = (Int64.to_int balance'0 >= Int64.to_int amount)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let rec check_sufficient_funds_V [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ledger.rs" 498 4 498 78]
  (self: t_Ledger) (amount: Int64.t) (return (x: t_Result_unit_tup2_i64_i64)) = (! bb0
  [ bb0 = s0
    [ s0 = [ &_7 <- Int64.lt self.balance amount ] s1 | s1 = any [ br0 -> {_7 = false} (! bb2) | br1 -> {_7} (! bb1) ] ]
  | bb1 = s0
    [ s0 = [ &_10 <- { f0 = self.balance; f1 = amount } ] s1 | s1 = [ &_ret <- Err _10 ] s2 | s2 = return {_ret} ]
  | bb2 = s0 [ s0 = [ &_ret <- Ok _13 ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_Result_unit_tup2_i64_i64 = Any.any_l ()
  | & self: t_Ledger = self
  | & amount: Int64.t = amount
  | & _7: bool = Any.any_l ()
  | & _10: tup2_i64_i64 = Any.any_l ()
  | & _13: () = Any.any_l () ])
  [ return (result: t_Result_unit_tup2_i64_i64) ->
  {[@stop_split] [@expl:check_sufficient_funds ensures] [%#sledger'0] match result with
      | Ok () -> sufficient_funds_holds self.balance amount true
      | Err {f0 = balance'0; f1 = required} -> balance'0 = self.balance
      /\ required = amount /\ sufficient_funds_holds self.balance amount false
      end}
    (! return {result}) ]
