predicate check_sufficient_funds_result_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ledger.rs" 506 8 510 17] (balance'0: Int64.t) (amount: Int64.t) (outcome: t_Result_unit_tup2_i64_i64) =
