use creusot.int.Int64
use creusot.prelude.Any
use int.Int

predicate amount_positive_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ledger/ledger_validate.rs" 252 8 252 72] (amount: Int64.t) (outcome: bool) =
  [%#sledger_validate'2] outcome = (Int64.to_int amount > 0)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let rec check_amount_positive
  [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ledger/ledger_validate.rs" 292 8 292 64] (amount: Int64.t)
  (return (x: bool)) = (! bb0
  [ bb0 = s0 [ s0 = [ &_ret <- Int64.gt amount ([%#sledger_validate] (0: Int64.t)) ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l () | & amount: Int64.t = amount ])
  [ return (result: bool) ->
  {[@stop_split] [@expl:check_amount_positive ensures] [%#sledger_validate'1] amount_positive_holds amount result}
    (! return {result}) ]
