use creusot.int.Int64
use creusot.prelude.Any

type t_TransferError = NegativeAmount Int64.t | InsufficientFunds Int64.t Int64.t | SameAccount

predicate negative_amount_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ledger/ledger_validate.rs" 128 8 128 85] (bad: Int64.t) (outcome: t_TransferError) =
  [%#sledger_validate'1] match outcome with
    | NegativeAmount actual -> actual = bad
    | _ -> false
    end

