use creusot.int.Int64
use creusot.int.UInt64
use creusot.prelude.Any
use int.Int

predicate amount_positive_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ledger.rs" 61 8 61 72] (amount: Int64.t) (outcome: bool) =
  [%#sledger'11] outcome = (Int64.to_int amount > 0)

let rec check_amount_positive (amount: Int64.t) (return (x: bool)) = any
  [ return (result: bool) ->
  {[@stop_split] [@expl:check_amount_positive ensures] [%#sledger'5] amount_positive_holds amount result}
    (! return {result}) ]

predicate sufficient_funds_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ledger.rs" 84 8 84 87] (balance: Int64.t) (amount: Int64.t) (outcome: bool) =
  [%#sledger'12] outcome = (Int64.to_int balance >= Int64.to_int amount)

let rec check_sufficient_funds (balance: Int64.t) (amount: Int64.t) (return (x: bool)) = any
  [ return (result: bool) ->
  {[@stop_split] [@expl:check_sufficient_funds ensures] [%#sledger'7] sufficient_funds_holds balance amount result}
    (! return {result}) ]

predicate accounts_distinct_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ledger.rs" 109 8 109 81] (from: UInt64.t) (to': UInt64.t) (outcome: bool) =
  [%#sledger'13] outcome = (from <> to')

let rec check_accounts_distinct (from: UInt64.t) (to': UInt64.t) (return (x: bool)) = any
  [ return (result: bool) ->
  {[@stop_split] [@expl:check_accounts_distinct ensures] [%#sledger'9] accounts_distinct_holds from to' result}
    (! return {result}) ]

type t_TransferOutcome = Ok | NegativeAmount Int64.t | InsufficientFunds Int64.t Int64.t | SameAccount

type t_Ordering = Less | Equal | Greater

function cmp_log_i64 (self: Int64.t) (o: Int64.t) : t_Ordering = [%#sord'12] if Int64.lt self o then
    Less
  else
    if self = o then Equal else Greater


function eq_cmp_i64 (x: Int64.t) (y: Int64.t) : ()

axiom eq_cmp_i64_spec: forall x: Int64.t, y: Int64.t. [%#sord'11] (x = y) = (cmp_log_i64 x y = Equal)

function antisym2_i64 (x: Int64.t) (y: Int64.t) : ()

axiom antisym2_i64_spec: forall x: Int64.t, y: Int64.t. ([%#sord'9] cmp_log_i64 x y = Greater)
    -> ([%#sord'10] cmp_log_i64 y x = Less)

function antisym1_i64 (x: Int64.t) (y: Int64.t) : ()

axiom antisym1_i64_spec: forall x: Int64.t, y: Int64.t. ([%#sord'7] cmp_log_i64 x y = Less)
    -> ([%#sord'8] cmp_log_i64 y x = Greater)

function trans_i64 (x: Int64.t) (y: Int64.t) (z: Int64.t) (o: t_Ordering) : ()

axiom trans_i64_spec: forall x: Int64.t, y: Int64.t, z: Int64.t, o: t_Ordering. ([%#sord'4] cmp_log_i64 x y = o)
    -> ([%#sord'5] cmp_log_i64 y z = o) -> ([%#sord'6] cmp_log_i64 x z = o)

function refl_i64 (x: Int64.t) : ()

axiom refl_i64_spec: forall x: Int64.t. [%#sord'3] cmp_log_i64 x x = Equal

function cmp_gt_log_i64 (x: Int64.t) (y: Int64.t) : ()

axiom cmp_gt_log_i64_spec: forall x: Int64.t, y: Int64.t. [%#sord'2] Int64.gt x y = (cmp_log_i64 x y = Greater)

function cmp_ge_log_i64 (x: Int64.t) (y: Int64.t) : ()

axiom cmp_ge_log_i64_spec: forall x: Int64.t, y: Int64.t. [%#sord'1] Int64.ge x y = (cmp_log_i64 x y <> Less)

function cmp_lt_log_i64 (x: Int64.t) (y: Int64.t) : ()

axiom cmp_lt_log_i64_spec: forall x: Int64.t, y: Int64.t. [%#sord'0] Int64.lt x y = (cmp_log_i64 x y = Less)

function cmp_le_log_i64 (x: Int64.t) (y: Int64.t) : ()

axiom cmp_le_log_i64_spec: forall x: Int64.t, y: Int64.t. [%#sord] Int64.le x y = (cmp_log_i64 x y <> Greater)

predicate validated_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ledger.rs" 158 8 158 93] (amount: Int64.t) (from: UInt64.t) (to': UInt64.t) (outcome: t_TransferOutcome) =
  [%#sledger'10] match outcome with
    | Ok -> amount_positive_holds amount true /\ accounts_distinct_holds from to' true
    | NegativeAmount bad -> bad = amount /\ Int64.to_int amount <= 0
    | InsufficientFunds balance required -> Int64.lt balance required
    | SameAccount -> true
    end

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let rec validate [#"/home/erik/repos/amenable/crates/amenable_creusot/src/ledger.rs" 178 8 178 85] (balance: Int64.t)
  (amount: Int64.t) (from: UInt64.t) (to': UInt64.t) (return (x: t_TransferOutcome)) = (! bb0
  [ bb0 = s0
    [ s0 = check_amount_positive [%#sledger] {amount} (fun (_x: bool) -> [ &_11 <- _x ] s1)
    | s1 = any [ br0 -> {_11 = false} (! bb3) | br1 -> {_11} (! bb2) ] ]
  | bb2 = s0
    [ s0 = check_sufficient_funds [%#sledger'0] {balance} {amount} (fun (_x: bool) -> [ &_16 <- _x ] s1)
    | s1 = any [ br0 -> {_16 = false} (! bb6) | br1 -> {_16} (! bb5) ] ]
  | bb5 = s0
    [ s0 = check_accounts_distinct [%#sledger'1] {from} {to'} (fun (_x: bool) -> [ &_23 <- _x ] s1)
    | s1 = any [ br0 -> {_23 = false} (! bb9) | br1 -> {_23} (! bb8) ] ]
  | bb8 = s0 [ s0 = [ &_ret <- Ok ] s1 | s1 = return {_ret} ]
  | bb9 = s0 [ s0 = [ &_ret <- SameAccount ] s1 | s1 = return {_ret} ]
  | bb6 = s0 [ s0 = [ &_ret <- InsufficientFunds balance amount ] s1 | s1 = return {_ret} ]
  | bb3 = s0 [ s0 = [ &_ret <- NegativeAmount amount ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_TransferOutcome = Any.any_l ()
  | & balance: Int64.t = balance
  | & amount: Int64.t = amount
  | & from: UInt64.t = from
  | & to': UInt64.t = to'
  | & _11: bool = Any.any_l ()
  | & _16: bool = Any.any_l ()
  | & _23: bool = Any.any_l () ])
  [ return (result: t_TransferOutcome) ->
  {[@stop_split] [@expl:validate ensures] [%#sledger'3] validated_holds amount from to' result}
    (! return {result}) ]
