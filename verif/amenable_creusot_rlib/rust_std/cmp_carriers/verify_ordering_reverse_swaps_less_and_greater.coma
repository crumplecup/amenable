use creusot.prelude.Any

type t_Ordering = Less | Equal | Greater

type tup2_Ordering_Ordering = { f0: t_Ordering; f1: t_Ordering }

let rec reverse (self_: t_Ordering) (return (x: t_Ordering)) = any
  [ return (result: t_Ordering) -> {[@stop_split] [@expl:reverse ensures] [%#scmp_carriers'2] match { f0 = self_;
                                                                                                      f1 = result } with
      | {f0 = Less; f1 = Greater} -> true
      | {f0 = Equal; f1 = Equal} -> true
      | {f0 = Greater; f1 = Less} -> true
      | _ -> false
      end}
    (! return {result}) ]

