type t_Cow_i32 = Borrowed Int32.t | Owned Int32.t

let rec elim_Owned (_x: t_Cow_i32) (return (f0: Int32.t)) = any
  [ _k (f0: Int32.t) -> {Owned f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Owned] match _x with
      | Owned _ -> true
      | _ -> false
      end}
    any) ]

let rec elim_Borrowed (_x: t_Cow_i32) (return (f0: Int32.t)) = any
  [ _k (f0: Int32.t) -> {Borrowed f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Borrowed] match _x with
      | Borrowed _ -> true
      | _ -> false
      end}
    any) ]

