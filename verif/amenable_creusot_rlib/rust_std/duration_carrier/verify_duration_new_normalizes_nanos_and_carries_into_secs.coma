use creusot.int.UInt64
use creusot.int.UInt32
use int.ComputerDivision
use creusot.prelude.Any
use int.Int

type t_Duration

function nanos_to_secs (nanos: int) : int = [%#stime'1] ComputerDivision.div nanos 1000000000

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

predicate inv_Duration (_1: t_Duration)

function secs_to_nanos (secs: int) : int = [%#stime'3] secs * 1000000000

function view_Duration (self: t_Duration) : int

axiom view_Duration_spec: forall self: t_Duration. [%#stime'2] view_Duration self >= 0
    /\ view_Duration self <= secs_to_nanos (UInt64.t'int const_MAX) + 999999999

let rec new (secs: UInt64.t) (nanos: UInt32.t) (return (x: t_Duration)) =
  {[@stop_split] [@expl:new requires] [%#stime] UInt64.t'int secs + nanos_to_secs (UInt32.t'int nanos)
  <= UInt64.t'int const_MAX}
  any
  [ return (result: t_Duration) ->
  {[@stop_split] [@expl:new ensures] ([@stop_split] [@expl:new result type invariant] inv_Duration result)
    /\ ([@stop_split] [@expl:new ensures] [%#stime'0] view_Duration result
    = secs_to_nanos (UInt64.t'int secs) + UInt32.t'int nanos)}
    (! return {result}) ]

predicate duration_new_headroom_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/rust_std/duration_carrier.rs" 13 8 13 69] (secs: UInt64.t) (nanos: UInt32.t) =
  [%#sduration_carrier'3] UInt64.t'int secs + ComputerDivision.div (UInt32.t'int nanos) 1000000000
  <= UInt64.t'int const_MAX

predicate duration_new_normalizes_nanos_and_carries_into_secs_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/rust_std/duration_carrier.rs" 29 8 33 17] (secs: UInt64.t) (nanos: UInt32.t) (duration_result: t_Duration) =
  [%#sduration_carrier'4] nanos_to_secs (view_Duration duration_result)
    = UInt64.t'int secs + ComputerDivision.div (UInt32.t'int nanos) 1000000000
  /\ ComputerDivision.mod (view_Duration duration_result) 1000000000
  = ComputerDivision.mod (UInt32.t'int nanos) 1000000000

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let rec verify_duration_new_normalizes_nanos_and_carries_into_secs
  [#"/home/erik/repos/amenable/crates/amenable_creusot/src/rust_std/duration_carrier.rs" 80 8 83 21] (secs: UInt64.t)
  (nanos: UInt32.t) (return (x: t_Duration)) =
  {[@stop_split] [@expl:verify_duration_new_normalizes_nanos_and_carries_into_secs requires] [%#sduration_carrier'0] duration_new_headroom_holds secs nanos}
  (! bb0
  [ bb0 = s0
    [ s0 = new [%#sduration_carrier] {secs} {nanos} (fun (_x: t_Duration) -> [ &_ret <- _x ] s1)
    | s1 = return {_ret} ] ]
  [ & _ret: t_Duration = Any.any_l () | & secs: UInt64.t = secs | & nanos: UInt32.t = nanos ])
  [ return (result: t_Duration) ->
  {[@stop_split] [@expl:verify_duration_new_normalizes_nanos_and_carries_into_secs ensures] ([@stop_split] [@expl:verify_duration_new_normalizes_nanos_and_carries_into_secs result type invariant] [%#sduration_carrier'1] inv_Duration result)
    /\ ([@stop_split] [@expl:verify_duration_new_normalizes_nanos_and_carries_into_secs ensures] [%#sduration_carrier'2] duration_new_normalizes_nanos_and_carries_into_secs_holds secs nanos result)}
