  [ return (result: t_Result_u8_TryFromIntError) ->
  {[@stop_split] [@expl:verify_try_from_int_error_occurs_exactly_when_out_of_range ensures] ([@stop_split] [@expl:verify_try_from_int_error_occurs_exactly_when_out_of_range result type invariant] [%#sparse'1] inv_Result_u8_TryFromIntError result)
    /\ ([@stop_split] [@expl:verify_try_from_int_error_occurs_exactly_when_out_of_range ensures] [%#sparse'2] try_from_int_error_occurs_exactly_when_out_of_range_holds value result)}
