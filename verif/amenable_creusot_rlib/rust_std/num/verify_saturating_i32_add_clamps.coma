use creusot.int.Int32
use creusot.prelude.Any
use int.Int

type t_Saturating_i32 = { f0: Int32.t }

constant const_MIN: Int32.t = (-2147483648: Int32.t)

constant const_MAX: Int32.t = (2147483647: Int32.t)

let rec add_Saturating_i32 (self_: t_Saturating_i32) (rhs: t_Saturating_i32) (return (x: t_Saturating_i32)) = any
  [ return (result: t_Saturating_i32) ->
  {[@stop_split] [@expl:add_Saturating_i32 ensures] ([@stop_split] [@expl:add ensures #0] [%#snum'2] Int32.to_int self_.f0
            + Int32.to_int rhs.f0
          >= Int32.to_int const_MIN
        /\ Int32.to_int self_.f0 + Int32.to_int rhs.f0 <= Int32.to_int const_MAX
      -> Int32.to_int result.f0 = Int32.to_int self_.f0 + Int32.to_int rhs.f0)
    /\ ([@stop_split] [@expl:add ensures #1] [%#snum'3] Int32.to_int self_.f0 + Int32.to_int rhs.f0
        < Int32.to_int const_MIN -> Int32.to_int result.f0 = Int32.to_int const_MIN)
    /\ ([@stop_split] [@expl:add ensures #2] [%#snum'4] Int32.to_int self_.f0 + Int32.to_int rhs.f0
      > Int32.to_int const_MAX -> Int32.to_int result.f0 = Int32.to_int const_MAX)}
    (! return {result}) ]

predicate saturating_i32_add_clamps_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/rust_std/num.rs" 217 8 221 17] (a: t_Saturating_i32) (b: t_Saturating_i32) (add_result: t_Saturating_i32) =
  [%#snum'5] (Int32.to_int a.f0 + Int32.to_int b.f0 >= Int32.to_int const_MIN
      /\ Int32.to_int a.f0 + Int32.to_int b.f0 <= Int32.to_int const_MAX
    -> Int32.to_int add_result.f0 = Int32.to_int a.f0 + Int32.to_int b.f0)
  /\ (Int32.to_int a.f0 + Int32.to_int b.f0 < Int32.to_int const_MIN
    -> Int32.to_int add_result.f0 = Int32.to_int const_MIN)
  /\ (Int32.to_int a.f0 + Int32.to_int b.f0 > Int32.to_int const_MAX
  -> Int32.to_int add_result.f0 = Int32.to_int const_MAX)

