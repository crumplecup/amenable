use creusot.int.Int32
use creusot.prelude.Any

type t_Bound_i32 = Included Int32.t | Excluded Int32.t | Unbounded

type t_Option_i32 = None | Some Int32.t

type tup3_bool_bool_Option_i32 = { f0: bool; f1: bool; f2: t_Option_i32 }

let rec elim_Excluded (_x: t_Bound_i32) (return (f0'0: Int32.t)) = any
  [ _k (f0'0: Int32.t) -> {Excluded f0'0 = _x} (! return {f0'0})
  | _chk -> (! {[@expl:elim Excluded] match _x with
      | Excluded _ -> true
      | _ -> false
      end}
    any) ]

let rec elim_Included (_x: t_Bound_i32) (return (f0'0: Int32.t)) = any
  [ _k (f0'0: Int32.t) -> {Included f0'0 = _x} (! return {f0'0})
  | _chk -> (! {[@expl:elim Included] match _x with
      | Included _ -> true
      | _ -> false
      end}
    any) ]

predicate bound_round_trips_its_endpoint_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/rust_std/ops_range_and_bound.rs" 116 8 119 17] (value: t_Bound_i32) (bound_result: tup3_bool_bool_Option_i32) =
  [%#sops_range_and_bound'7] match value with
    | Included inner -> bound_result = { f0 = true; f1 = false; f2 = Some inner }
    | Excluded inner -> bound_result = { f0 = false; f1 = true; f2 = Some inner }
    | Unbounded -> bound_result = { f0 = false; f1 = false; f2 = None }
    end

