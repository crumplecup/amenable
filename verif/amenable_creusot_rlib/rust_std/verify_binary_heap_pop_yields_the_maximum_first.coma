type t_Option_i32 = None | Some Int32.t

type tup2_Option_i32_Option_i32 = { f0: t_Option_i32; f1: t_Option_i32 }

type t_Ordering = Less | Equal | Greater

function cmp_log_i32 (self: Int32.t) (o: Int32.t) : t_Ordering = [%#sord'12] if Int32.lt self o then
    Less
  else
    if self = o then Equal else Greater


function eq_cmp_i32 (x: Int32.t) (y: Int32.t) : ()

axiom eq_cmp_i32_spec: forall x: Int32.t, y: Int32.t. [%#sord'11] (x = y) = (cmp_log_i32 x y = Equal)

function antisym2_i32 (x: Int32.t) (y: Int32.t) : ()

axiom antisym2_i32_spec: forall x: Int32.t, y: Int32.t. ([%#sord'9] cmp_log_i32 x y = Greater)
    -> ([%#sord'10] cmp_log_i32 y x = Less)

function antisym1_i32 (x: Int32.t) (y: Int32.t) : ()

axiom antisym1_i32_spec: forall x: Int32.t, y: Int32.t. ([%#sord'7] cmp_log_i32 x y = Less)
    -> ([%#sord'8] cmp_log_i32 y x = Greater)

function trans_i32 (x: Int32.t) (y: Int32.t) (z: Int32.t) (o: t_Ordering) : ()

axiom trans_i32_spec: forall x: Int32.t, y: Int32.t, z: Int32.t, o: t_Ordering. ([%#sord'4] cmp_log_i32 x y = o)
    -> ([%#sord'5] cmp_log_i32 y z = o) -> ([%#sord'6] cmp_log_i32 x z = o)

function refl_i32 (x: Int32.t) : ()

axiom refl_i32_spec: forall x: Int32.t. [%#sord'3] cmp_log_i32 x x = Equal

function cmp_gt_log_i32 (x: Int32.t) (y: Int32.t) : ()

axiom cmp_gt_log_i32_spec: forall x: Int32.t, y: Int32.t. [%#sord'2] Int32.gt x y = (cmp_log_i32 x y = Greater)

function cmp_ge_log_i32 (x: Int32.t) (y: Int32.t) : ()

axiom cmp_ge_log_i32_spec: forall x: Int32.t, y: Int32.t. [%#sord'1] Int32.ge x y = (cmp_log_i32 x y <> Less)

function cmp_lt_log_i32 (x: Int32.t) (y: Int32.t) : ()

axiom cmp_lt_log_i32_spec: forall x: Int32.t, y: Int32.t. [%#sord'0] Int32.lt x y = (cmp_log_i32 x y = Less)

function cmp_le_log_i32 (x: Int32.t) (y: Int32.t) : ()

axiom cmp_le_log_i32_spec: forall x: Int32.t, y: Int32.t. [%#sord] Int32.le x y = (cmp_log_i32 x y <> Greater)

