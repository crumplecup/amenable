use creusot.int.Int32
use creusot.prelude.Any

type t_ControlFlow_i32_i32 = Continue Int32.t | Break Int32.t

let rec elim_Break (_x: t_ControlFlow_i32_i32) (return (f0: Int32.t)) = any
  [ _k (f0: Int32.t) -> {Break f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Break] match _x with
      | Break _ -> true
      | _ -> false
      end}
    any) ]

type t_Option_i32 = None | Some Int32.t

type tup4_bool_bool_Option_i32_Option_i32 = { f0: bool; f1: bool; f2: t_Option_i32; f3: t_Option_i32 }

let rec elim_Continue (_x: t_ControlFlow_i32_i32) (return (f0'0: Int32.t)) = any
  [ _k (f0'0: Int32.t) -> {Continue f0'0 = _x} (! return {f0'0})
  | _chk -> (! {[@expl:elim Continue] match _x with
      | Continue _ -> true
      | _ -> false
      end}
    any) ]

