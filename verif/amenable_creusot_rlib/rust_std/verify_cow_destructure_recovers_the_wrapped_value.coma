  [ bb0 = any [ br0 (x0: Int32.t) -> {value = Borrowed x0} (! bb4) | br1 (x0: Int32.t) -> {value = Owned x0} (! bb3) ]
  | bb3 = s0
    [ s0 = elim_Owned {value} (fun (r0: Int32.t) -> [ &owned <- r0 ] s1)
