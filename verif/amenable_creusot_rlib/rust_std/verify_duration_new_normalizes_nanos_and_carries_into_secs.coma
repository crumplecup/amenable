use creusot.int.UInt64
use creusot.int.UInt32
use int.ComputerDivision
use creusot.prelude.Any
use int.Int

type t_Duration

function nanos_to_secs (nanos: int) : int = [%#stime'1] ComputerDivision.div nanos 1000000000

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

predicate inv_Duration (_1: t_Duration)

function secs_to_nanos (secs: int) : int = [%#stime'3] secs * 1000000000

function view_Duration (self: t_Duration) : int

axiom view_Duration_spec: forall self: t_Duration. [%#stime'2] view_Duration self >= 0
    /\ view_Duration self <= secs_to_nanos (UInt64.t'int const_MAX) + 999999999

let rec new (secs: UInt64.t) (nanos: UInt32.t) (return (x: t_Duration)) =
  {[@stop_split] [@expl:new requires] [%#stime] UInt64.t'int secs + nanos_to_secs (UInt32.t'int nanos)
  <= UInt64.t'int const_MAX}
  any
  [ return (result: t_Duration) ->
  {[@stop_split] [@expl:new ensures] ([@stop_split] [@expl:new result type invariant] inv_Duration result)
    /\ ([@stop_split] [@expl:new ensures] [%#stime'0] view_Duration result
    = secs_to_nanos (UInt64.t'int secs) + UInt32.t'int nanos)}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let rec verify_duration_new_normalizes_nanos_and_carries_into_secs
  [#"/home/erik/repos/amenable/crates/amenable_creusot/src/rust_std.rs" 1247 8 1250 21] (secs: UInt64.t)
  (nanos: UInt32.t) (return (x: t_Duration)) =
  {[@stop_split] [@expl:verify_duration_new_normalizes_nanos_and_carries_into_secs requires] [%#srust_std'0] UInt64.t'int secs
    + ComputerDivision.div (UInt32.t'int nanos) 1000000000
  <= UInt64.t'int const_MAX}
  (! bb0
  [ bb0 = s0
    [ s0 = new [%#srust_std] {secs} {nanos} (fun (_x: t_Duration) -> [ &_ret <- _x ] s1) | s1 = return {_ret} ] ]
  [ & _ret: t_Duration = Any.any_l () | & secs: UInt64.t = secs | & nanos: UInt32.t = nanos ])
  [ return (result: t_Duration) ->
  {[@stop_split] [@expl:verify_duration_new_normalizes_nanos_and_carries_into_secs ensures] ([@stop_split] [@expl:verify_duration_new_normalizes_nanos_and_carries_into_secs result type invariant] [%#srust_std'1] inv_Duration result)
    /\ ([@stop_split] [@expl:verify_duration_new_normalizes_nanos_and_carries_into_secs ensures #0] [%#srust_std'2] nanos_to_secs (view_Duration result)
      = UInt64.t'int secs + ComputerDivision.div (UInt32.t'int nanos) 1000000000)
    /\ ([@stop_split] [@expl:verify_duration_new_normalizes_nanos_and_carries_into_secs ensures #1] [%#srust_std'3] ComputerDivision.mod (view_Duration result) 1000000000
    = ComputerDivision.mod (UInt32.t'int nanos) 1000000000)}
    (! return {result}) ]
