let rec verify_nul_error_reports_the_interior_nuls_position
  [#"/home/erik/repos/amenable/crates/amenable_creusot/src/rust_std.rs" 1706 8 1706 90] (byte: UInt8.t)
  (return (x: tup2_usize_usize)) =
  {[@stop_split] [@expl:verify_nul_error_reports_the_interior_nuls_position requires] [%#srust_std'1] UInt8.t'int byte
  <> 0}
  (! bb0
  [ bb0 = s0
    [ s0 = [ &_ret <- { f0 = ([%#srust_std] (1: UInt64.t)); f1 = ([%#srust_std'0] (1: UInt64.t)) } ] s1
    | s1 = return {_ret} ] ] [ & _ret: tup2_usize_usize = Any.any_l () ])
  [ return (result: tup2_usize_usize) ->
  {[@stop_split] [@expl:verify_nul_error_reports_the_interior_nuls_position ensures] [%#srust_std'2] match result with
