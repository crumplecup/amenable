use creusot.int.Int32
use creusot.prelude.Any

type t_Option_i32 = None | Some Int32.t

let rec unwrap_i32 (self_: t_Option_i32) (return (x: Int32.t)) =
  {[@stop_split] [@expl:unwrap requires] [%#soption] self_ <> None}
  any
  [ return (result: Int32.t) -> {[@stop_split] [@expl:unwrap ensures] [%#soption'0] Some result = self_}
    (! return {result}) ]

predicate resolve_i32 [@inline:trivial] (_1: Int32.t) = true

meta "rewrite_def" predicate resolve_i32

let rec unwrap_or_i32 (self_: t_Option_i32) (default: Int32.t) (return (x: Int32.t)) = any
  [ return (result: Int32.t) ->
  {[@stop_split] [@expl:unwrap_or_i32 ensures] ([@stop_split] [@expl:unwrap_or ensures #0] [%#soption'1] self_ = None
      -> result = default)
    /\ ([@stop_split] [@expl:unwrap_or ensures #1] [%#soption'2] self_ = None
    \/ self_ = Some result /\ resolve_i32 default)}
    (! return {result}) ]

