type t_Poll_i32 = Ready Int32.t | Pending

let rec elim_Ready (_x: t_Poll_i32) (return (f0: Int32.t)) = any
  [ _k (f0: Int32.t) -> {Ready f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Ready] match _x with
