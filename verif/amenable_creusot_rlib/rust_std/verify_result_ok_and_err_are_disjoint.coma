use creusot.int.Int32
use creusot.prelude.Any

type t_Result_i32_i32 = Ok Int32.t | Err Int32.t

let rec unwrap_i32 (self_: t_Result_i32_i32) (return (x: Int32.t)) =
  {[@stop_split] [@expl:unwrap requires] [%#sresult] exists t: Int32.t. self_ = Ok t}
  any
  [ return (result: Int32.t) -> {[@stop_split] [@expl:unwrap ensures] [%#sresult'0] Ok result = self_}
    (! return {result}) ]

let rec unwrap_err_i32 (self_: t_Result_i32_i32) (return (x: Int32.t)) =
  {[@stop_split] [@expl:unwrap_err requires] [%#sresult'1] exists e: Int32.t. self_ = Err e}
  any
  [ return (result: Int32.t) -> {[@stop_split] [@expl:unwrap_err ensures] [%#sresult'2] Err result = self_}
    (! return {result}) ]

type tup2_i32_i32 = { f0: Int32.t; f1: Int32.t }

