use creusot.int.Int32
use creusot.int.UInt8
use creusot.prelude.Any
use int.Int

type t_TryFromIntError

type t_Result_u8_TryFromIntError = Ok UInt8.t | Err t_TryFromIntError

predicate inv_TryFromIntError (_1: t_TryFromIntError)

predicate inv_Result_u8_TryFromIntError (_1: t_Result_u8_TryFromIntError)

axiom inv_axiom [@rewrite]:
  forall x: t_Result_u8_TryFromIntError [inv_Result_u8_TryFromIntError x]. inv_Result_u8_TryFromIntError x
    = match x with
      | Ok f0 -> true
      | Err f0 -> inv_TryFromIntError f0
      end

let rec try_from_u8 (value: Int32.t) (return (x: t_Result_u8_TryFromIntError)) = any
  [ return (result: t_Result_u8_TryFromIntError) ->
  {[@stop_split] [@expl:try_from_u8 ensures] ([@stop_split] [@expl:try_from result type invariant] inv_Result_u8_TryFromIntError result)
    /\ ([@stop_split] [@expl:try_from ensures] [%#srust_std'3] match result with
      | Ok v -> Int32.to_int value >= 0 /\ Int32.to_int value <= 255 /\ UInt8.t'int v = Int32.to_int value
      | Err _ -> Int32.to_int value < 0 \/ Int32.to_int value > 255
      end)}
    (! return {result}) ]

