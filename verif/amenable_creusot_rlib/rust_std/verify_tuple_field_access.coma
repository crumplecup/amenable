type tup2_i32_i32 = { f0: Int32.t; f1: Int32.t }

predicate tuple_field_access_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/rust_std.rs" 1062 8 1062 85] (a: Int32.t) (b: Int32.t) (tuple_result: tup2_i32_i32) =
