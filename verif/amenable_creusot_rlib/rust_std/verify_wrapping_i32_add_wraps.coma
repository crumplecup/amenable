type t_Wrapping_i32 = { f0: Int32.t }

let rec add_Wrapping_i32 (self_: t_Wrapping_i32) (rhs: t_Wrapping_i32) (return (x: t_Wrapping_i32)) = any
  [ return (result: t_Wrapping_i32) -> {[@stop_split] [@expl:add ensures] [%#srust_std'2] result.f0
    = Int32.add self_.f0 rhs.f0}
