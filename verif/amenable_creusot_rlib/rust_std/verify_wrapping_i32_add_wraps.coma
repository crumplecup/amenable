    | s1 = return {_ret} ] ]
  [ & _ret: t_Wrapping_i32 = Any.any_l () | & a: t_Wrapping_i32 = a | & b: t_Wrapping_i32 = b ])
  [ return (result: t_Wrapping_i32) ->
