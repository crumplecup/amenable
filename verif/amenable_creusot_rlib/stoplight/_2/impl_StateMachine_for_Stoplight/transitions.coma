use creusot.slice.Slice64
use seq.Seq
use creusot.prelude.Any
use int.Int

type t_Transition

predicate inv_Transition (_1: t_Transition)

predicate invariant_ref_Transition [@inline:trivial] (self: t_Transition) = [%#sinvariant] inv_Transition self

meta "rewrite_def" predicate invariant_ref_Transition

predicate inv_ref_Transition [@inline:trivial] (_1: t_Transition) = invariant_ref_Transition _1

meta "rewrite_def" predicate inv_ref_Transition

predicate invariant_Seq_Transition [@inline:trivial] (self: Seq.seq t_Transition) =
  [%#sseq] forall i: int. 0 <= i /\ i < Seq.length self -> inv_ref_Transition (Seq.get self i)

meta "rewrite_def" predicate invariant_Seq_Transition

predicate inv_Seq_Transition [@inline:trivial] (_1: Seq.seq t_Transition) = invariant_Seq_Transition _1

meta "rewrite_def" predicate inv_Seq_Transition

predicate invariant_slice_Transition (self: Slice64.slice t_Transition) =
  [%#sslice] inv_Seq_Transition (Slice64.view self)

predicate inv_slice_Transition [@inline:trivial] (_1: Slice64.slice t_Transition) = invariant_slice_Transition _1

meta "rewrite_def" predicate inv_slice_Transition

predicate invariant_ref_slice_Transition [@inline:trivial] (self: Slice64.slice t_Transition) =
  [%#sinvariant] inv_slice_Transition self

meta "rewrite_def" predicate invariant_ref_slice_Transition

predicate inv_ref_slice_Transition [@inline:trivial] (_1: Slice64.slice t_Transition) =
  invariant_ref_slice_Transition _1

meta "rewrite_def" predicate inv_ref_slice_Transition

constant const_TRANSITIONS [#"/home/erik/repos/amenable/crates/amenable_creusot/src/stoplight.rs" 302 9 302 38] : Slice64.slice t_Transition

axiom const_TRANSITIONS_spec: [%#sstoplight] inv_ref_slice_Transition const_TRANSITIONS

let rec set_TRANSITIONS (return) = bb0
  [ bb0 = s0
    [ s0 = bb0'0
      [ bb0'0 = {[%#sstoplight] false} any ]
      [ & _ret'0: Slice64.array t_Transition = Any.any_l ()
      | & _1: Slice64.array t_Transition = Any.any_l ()
      | & _2'0: t_Transition = Any.any_l ()
      | & _3: t_Transition = Any.any_l ()
      | & _4: t_Transition = Any.any_l () ] [ _const_ret (_const: Slice64.array t_Transition) -> [ &_7 <- _const ] s1 ]
    | s1 = [ &_2 <- _7 ] s2
    | s2 = [ &_ret <- _2 ] s3
    | s3 = return {_ret} ] ]
  [ & _ret: Slice64.slice t_Transition = Any.any_l ()
  | & _2: Slice64.array t_Transition = Any.any_l ()
  | & _7: Slice64.array t_Transition = Any.any_l () ]
  [ return (_const: Slice64.slice t_Transition) -> -{const_TRANSITIONS = _const}- return ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let rec transitions_Stoplight [#"/home/erik/repos/amenable/crates/amenable_creusot/src/stoplight.rs" 302 9 302 38]
  (return (x: Slice64.slice t_Transition)) = set_TRANSITIONS
    ((! bb0
    [ bb0 = s0 [ s0 = [ &_ret <- [%#sstoplight] const_TRANSITIONS ] s1 | s1 = return {_ret} ] ]
    [ & _ret: Slice64.slice t_Transition = Any.any_l () ])
    [ return (result: Slice64.slice t_Transition) ->
    {[@stop_split] [@expl:transitions result type invariant] [%#sstoplight] inv_ref_slice_Transition result}
      (! return {result}) ])
