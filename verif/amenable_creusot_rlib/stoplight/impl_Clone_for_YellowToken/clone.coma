meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let rec clone_YellowToken [#"/home/erik/repos/amenable/crates/amenable_creusot/src/stoplight.rs" 161 4 161 27]
  (self: t_YellowToken) (return (x: t_YellowToken)) = (! bb0
