(* <stoplight::Green as amenable_core::Establish<stoplight::RedToken, witness::CreusotVerifier>> *)

use creusot.prelude.Any

type t_GreenToken = { f0: () }

type t_RedToken = { f0'0: () }

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let rec establish_Green [#"/home/erik/repos/amenable/crates/amenable_creusot/src/stoplight.rs" 282 4 282 54]
  (_credential: t_RedToken) (return (x: t_GreenToken)) = (! bb0
  [ bb0 = s0 [ s0 = [ &_ret <- { f0 = _2 } ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_GreenToken = Any.any_l () | & _2: () = Any.any_l () ])
  [ return (result: t_GreenToken) -> (! return {result}) ]
