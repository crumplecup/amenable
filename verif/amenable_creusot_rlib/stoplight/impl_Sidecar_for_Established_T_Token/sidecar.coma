use creusot.prelude.Any

type t_Token

type t_T

type t_Established_T_Token = { primary: t_T; token: t_Token }

predicate inv_Token (_1: t_Token)

predicate invariant_ref_Token [@inline:trivial] (self: t_Token) = [%#sinvariant] inv_Token self

meta "rewrite_def" predicate invariant_ref_Token

predicate inv_ref_Token [@inline:trivial] (_1: t_Token) = invariant_ref_Token _1

meta "rewrite_def" predicate inv_ref_Token

predicate precondition_clone (self: ()) (args: t_Token)

axiom precondition_fndef:
  forall args: t_Token [precondition_clone () args]. (let self_ = args in [%#sclone] inv_ref_Token self_)
    -> precondition_clone () args

predicate postcondition_once_clone (self: ()) (args: t_Token) (result: t_Token)

axiom postcondition_fndef:
  forall args: t_Token, res: t_Token [postcondition_once_clone () args res]. postcondition_once_clone () args res
    -> (let self_ = args in inv_Token res)

let rec clone_Token (self_: t_Token) (return (x: t_Token)) =
  {[@stop_split] [@expl:clone requires] precondition_clone () self_}
  any
  [ return (result: t_Token) -> {[@stop_split] [@expl:clone ensures] postcondition_once_clone () self_ result}
    (! return {result}) ]

predicate inv_T (_1: t_T)

predicate inv_Established_T_Token (_1: t_Established_T_Token)

axiom inv_axiom [@rewrite]: forall x: t_Established_T_Token [inv_Established_T_Token x]. inv_Established_T_Token x
    = (inv_T x.primary /\ inv_Token x.token)

predicate invariant_ref_Established_T_Token [@inline:trivial] (self: t_Established_T_Token) =
  [%#sinvariant] inv_Established_T_Token self

meta "rewrite_def" predicate invariant_ref_Established_T_Token

predicate inv_ref_Established_T_Token [@inline:trivial] (_1: t_Established_T_Token) =
  invariant_ref_Established_T_Token _1

meta "rewrite_def" predicate inv_ref_Established_T_Token

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let rec sidecar_Established_T_Token [#"/home/erik/repos/amenable/crates/amenable_creusot/src/stoplight.rs" 255 4 255 43]
  (self: t_Established_T_Token) (return (x: t_Token)) =
  {[@stop_split] [@expl:sidecar 'self' type invariant] [%#sstoplight'0] inv_ref_Established_T_Token self}
  (! bb0
  [ bb0 = s0
    [ s0 = clone_Token [%#sstoplight] {self.token} (fun (_x: t_Token) -> [ &_ret <- _x ] s1) | s1 = return {_ret} ] ]
  [ & _ret: t_Token = Any.any_l () | & self: t_Established_T_Token = self ])
  [ return (result: t_Token) -> {[@stop_split] [@expl:sidecar result type invariant] [%#sstoplight'1] inv_Token result}
    (! return {result}) ]
