use creusot.prelude.Any
use int.Int

type t_Vec_TransitionAudit_Global

type t_TransitionAudit

predicate inv_TransitionAudit (_1: t_TransitionAudit)

predicate invariant_ref_TransitionAudit [@inline:trivial] (self: t_TransitionAudit) =
  [%#sinvariant] inv_TransitionAudit self

meta "rewrite_def" predicate invariant_ref_TransitionAudit

predicate inv_ref_TransitionAudit [@inline:trivial] (_1: t_TransitionAudit) = invariant_ref_TransitionAudit _1

meta "rewrite_def" predicate inv_ref_TransitionAudit

predicate invariant_Seq_TransitionAudit [@inline:trivial] (self: Seq.seq t_TransitionAudit) =
  [%#sseq] forall i: int. 0 <= i /\ i < Seq.length self -> inv_ref_TransitionAudit (Seq.get self i)

meta "rewrite_def" predicate invariant_Seq_TransitionAudit

predicate inv_Seq_TransitionAudit [@inline:trivial] (_1: Seq.seq t_TransitionAudit) = invariant_Seq_TransitionAudit _1

meta "rewrite_def" predicate inv_Seq_TransitionAudit

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_TransitionAudit_Global (self: t_Vec_TransitionAudit_Global) : Seq.seq t_TransitionAudit

axiom view_Vec_TransitionAudit_Global_spec:
  forall self: t_Vec_TransitionAudit_Global. [%#svec'0] Seq.length (view_Vec_TransitionAudit_Global self)
    <= UInt64.t'int const_MAX

predicate invariant_Vec_TransitionAudit_Global (self: t_Vec_TransitionAudit_Global) =
  [%#svec'1] inv_Seq_TransitionAudit (view_Vec_TransitionAudit_Global self)

predicate inv_Vec_TransitionAudit_Global (_1: t_Vec_TransitionAudit_Global)

axiom inv_axiom:
  forall x: t_Vec_TransitionAudit_Global [inv_Vec_TransitionAudit_Global x]. inv_Vec_TransitionAudit_Global x
