use int.Int

type t_Vec_TransitionAudit_Global

type t_TransitionAudit = { to': string; method_name: string; body: string }

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_TransitionAudit_Global (self: t_Vec_TransitionAudit_Global) : Seq.seq t_TransitionAudit

axiom view_Vec_TransitionAudit_Global_spec:
  forall self: t_Vec_TransitionAudit_Global. [%#svec'0] Seq.length (view_Vec_TransitionAudit_Global self)
    <= UInt64.t'int const_MAX

let rec new_TransitionAudit (return (x: t_Vec_TransitionAudit_Global)) = any
