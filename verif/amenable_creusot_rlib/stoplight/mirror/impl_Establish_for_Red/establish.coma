(* <stoplight::mirror::Red as amenable_core::Establish<stoplight::mirror::YellowToken, witness::CreusotVerifier>> *)

use creusot.prelude.Any

type t_RedToken = { f0: () }

type t_YellowToken = { f0'0: () }

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let rec establish_Red [#"/home/erik/repos/amenable/crates/amenable_creusot/src/stoplight.rs" 252 8 252 61]
  (_credential: t_YellowToken) (return (x: t_RedToken)) = (! bb0
  [ bb0 = s0 [ s0 = [ &_ret <- { f0 = _2 } ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_RedToken = Any.any_l () | & _2: () = Any.any_l () ])
  [ return (result: t_RedToken) -> (! return {result}) ]
