use creusot.prelude.Any

type t_T

type t_Token

type t_Established_T_Token = { primary: t_T; token: t_Token }

predicate inv_Token (_1: t_Token)

predicate invariant_ref_Token [@inline:trivial] (self: t_Token) = [%#sinvariant] inv_Token self

meta "rewrite_def" predicate invariant_ref_Token

predicate inv_ref_Token [@inline:trivial] (_1: t_Token) = invariant_ref_Token _1

meta "rewrite_def" predicate inv_ref_Token

predicate precondition_clone (self: ()) (args: t_Token)

axiom precondition_fndef:
  forall args: t_Token [precondition_clone () args]. (let self = args in [%#sclone] inv_ref_Token self)
    -> precondition_clone () args

predicate postcondition_clone (self: ()) (args: t_Token) (result: t_Token)

axiom postcondition_fndef:
  forall args: t_Token, result: t_Token [postcondition_clone () args result]. postcondition_clone () args result
    -> (let self = args in [%#sclone'0] inv_Token result)

predicate postcondition_once_clone (self: ()) (args: t_Token) (result: t_Token) = postcondition_clone self args result

meta "rewrite_def" predicate postcondition_once_clone

let clone_Token (self: t_Token) (return (x: t_Token)) =
{[@stop_split] [@expl:clone requires] precondition_clone () self}
  any
  [ return (result: t_Token) -> {[@stop_split] [@expl:clone ensures] postcondition_once_clone () self result}
    (! return {result}) ]

predicate inv_T (_1: t_T)

predicate inv_Established_T_Token (_1: t_Established_T_Token)

axiom inv_axiom [@rewrite]: forall _1: t_Established_T_Token [inv_Established_T_Token _1]. inv_Established_T_Token _1
    = (inv_T _1.primary /\ inv_Token _1.token)

predicate invariant_ref_Established_T_Token [@inline:trivial] (self: t_Established_T_Token) =
  [%#sinvariant] inv_Established_T_Token self

meta "rewrite_def" predicate invariant_ref_Established_T_Token

predicate inv_ref_Established_T_Token [@inline:trivial] (_1: t_Established_T_Token) =
  invariant_ref_Established_T_Token _1

meta "rewrite_def" predicate inv_ref_Established_T_Token

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let sidecar_Established_T_Token [#"/home/erik/repos/amenable/crates/amenable_creusot/src/stoplight.rs" 226 13 226 37]
  (self: t_Established_T_Token) (return (x: t_Token)) =
{[@stop_split] [@expl:sidecar 'self' type invariant] [%#sstoplight] inv_ref_Established_T_Token self}
  (! bb0
  [ bb0 = s0
    [ s0 = [ &_3 <- self.token ] s1
    | s1 = clone_Token [%#sstoplight] {_3} (fun (_x: t_Token) -> [ &_ret <- _x ] s2)
    | s2 = return {_ret} ] ]
  [ & _ret: t_Token = Any.any_l () | & self: t_Established_T_Token = self | & _3: t_Token = Any.any_l () ])
  [ return (result: t_Token) -> {[@stop_split] [@expl:sidecar result type invariant] [%#sstoplight] inv_Token result}
    (! return {result}) ]
