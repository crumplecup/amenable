use creusot.int.Int64
use creusot.prelude.Any
use int.Int

function deep_model_i64 [@inline:trivial] (self: Int64.t) : int = [%#snum] Int64.to_int self

meta "rewrite_def" function deep_model_i64

let min_i64 (self_: Int64.t) (o: Int64.t) (return (x: Int64.t)) = any
  [ return (result: Int64.t) ->
  {[@stop_split] [@expl:min_i64 ensures] ([@stop_split] [@expl:min ensures #0] [%#scmp] deep_model_i64 result
      <= deep_model_i64 self_)
    /\ ([@stop_split] [@expl:min ensures #1] [%#scmp'0] deep_model_i64 result <= deep_model_i64 o)
    /\ ([@stop_split] [@expl:min ensures #2] [%#scmp'1] result = self_ \/ result = o)
    /\ ([@stop_split] [@expl:min ensures #3] [%#scmp'2] deep_model_i64 self_ < deep_model_i64 o -> result = self_)
    /\ ([@stop_split] [@expl:min ensures #4] [%#scmp'3] deep_model_i64 o <= deep_model_i64 self_ -> result = o)}
    (! return {result}) ]

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

constant const_MAX: Int64.t = (9223372036854775807: Int64.t)

predicate bounded_step_walk_requires [#"/home/erik/repos/amenable/crates/amenable_creusot/src/time/bounded_step_walk.rs" 68 8 68 81] (prev: Int64.t) (delta: Int64.t) (hi: Int64.t) =
  [%#sbounded_step_walk'3] gt_log_Int (Int64.to_int delta) 0
  /\ Int64.to_int prev <= Int64.to_int hi /\ Int64.to_int prev + Int64.to_int delta <= Int64.to_int const_MAX

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate bounded_step_walk_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/time/bounded_step_walk.rs" 91 8 91 89] (prev: Int64.t) (delta: Int64.t) (hi: Int64.t) (next: Int64.t) =
  [%#sbounded_step_walk'4] ge_log_Int (Int64.to_int next) (Int64.to_int prev)
  /\ Int64.to_int next - Int64.to_int prev <= Int64.to_int delta

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let check_bounded_step_walk [#"/home/erik/repos/amenable/crates/amenable_creusot/src/time/bounded_step_walk.rs" 116 8 116 73]
  (prev: Int64.t) (delta: Int64.t) (hi: Int64.t) (return (x: Int64.t)) =
{[@stop_split] [@expl:check_bounded_step_walk requires] [%#sbounded_step_walk'1] bounded_step_walk_requires prev delta hi}
  (! bb0
  [ bb0 = s0
    [ s0 = Int64.add [%#sbounded_step_walk] {prev} {delta} (fun (_x: Int64.t) -> [ &_12 <- _x ] s1)
    | s1 = min_i64 [%#sbounded_step_walk'0] {_12} {hi} (fun (_x: Int64.t) -> [ &_ret <- _x ] s2)
    | s2 = return {_ret} ] ]
  [ & _ret: Int64.t = Any.any_l ()
  | & prev: Int64.t = prev
  | & delta: Int64.t = delta
  | & hi: Int64.t = hi
  | & _12: Int64.t = Any.any_l () ])
  [ return (result: Int64.t) ->
  {[@stop_split] [@expl:check_bounded_step_walk ensures] [%#sbounded_step_walk'2] bounded_step_walk_holds prev delta hi result}
    (! return {result}) ]
