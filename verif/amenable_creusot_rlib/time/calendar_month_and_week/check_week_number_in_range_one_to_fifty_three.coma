  | bb2 = s0 [ s0 = [ &_ret <- [%#scalendar_month_and_week'1] false ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l () | & week: UInt8.t = week | & _5: bool = Any.any_l () ])
  [ return (result: bool) ->
  {[@stop_split] [@expl:check_week_number_in_range_one_to_fifty_three ensures] [%#scalendar_month_and_week'3] week_number_in_range_one_to_fifty_three_holds week result}
    (! return {result}) ]
