predicate week_number_in_range_one_to_fifty_three_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/time/calendar_month_and_week.rs" 222 8 222 93] (week: UInt8.t) (outcome: bool) =
  [%#scalendar_month_and_week'4] outcome = (ge_log_u8 week (1: UInt8.t) /\ UInt8.lt week (54: UInt8.t))

