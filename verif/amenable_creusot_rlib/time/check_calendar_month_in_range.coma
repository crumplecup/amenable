let%span stime'4 = "/home/erik/repos/amenable/crates/amenable_creusot/src/time.rs" 72 16 84 41

use creusot.int.UInt8
use creusot.prelude.Any

predicate calendar_month_in_range_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/time.rs" 70 8 70 78] (month: UInt8.t) (outcome: bool) =
  [%#stime'4] outcome
  = (month = (1: UInt8.t)
  \/ month = (2: UInt8.t)
  \/ month = (3: UInt8.t)
  \/ month = (4: UInt8.t)
  \/ month = (5: UInt8.t)
  \/ month = (6: UInt8.t)
  \/ month = (7: UInt8.t)
  \/ month = (8: UInt8.t)
  \/ month = (9: UInt8.t) \/ month = (10: UInt8.t) \/ month = (11: UInt8.t) \/ month = (12: UInt8.t))

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let check_calendar_month_in_range [#"/home/erik/repos/amenable/crates/amenable_creusot/src/time.rs" 106 8 106 59]
  (month: UInt8.t) (return (x: bool)) = (! bb0
  [ bb0 = s0
    [ s0 = [ &_5 <- UInt8.ge month ([%#stime] (1: UInt8.t)) ] s1
    | s1 = any [ br0 -> {_5 = false} (! bb2) | br1 -> {_5} (! bb1) ] ]
  | bb1 = s0 [ s0 = [ &_ret <- UInt8.le month ([%#stime'0] (12: UInt8.t)) ] s1 | s1 = return {_ret} ]
  | bb2 = s0 [ s0 = [ &_ret <- [%#stime'1] false ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l () | & month: UInt8.t = month | & _5: bool = Any.any_l () ])
  [ return (result: bool) ->
  {[@stop_split] [@expl:check_calendar_month_in_range ensures] [%#stime'3] calendar_month_in_range_holds month result}
    (! return {result}) ]
