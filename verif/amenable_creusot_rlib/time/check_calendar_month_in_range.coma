let%span stime'0 = "/home/erik/repos/amenable/crates/amenable_creusot/src/time.rs" 107 37 107 41
let%span stime'1 = "/home/erik/repos/amenable/crates/amenable_creusot/src/time.rs" 107 12 107 41
