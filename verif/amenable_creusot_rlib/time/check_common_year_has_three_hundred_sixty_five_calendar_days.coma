predicate is_gregorian_leap_year [#"/home/erik/repos/amenable/crates/amenable_creusot/src/time.rs" 1575 8 1575 56] (year: Int32.t) =
  [%#stime'15] ComputerDivision.mod (Int32.to_int year) 4 = 0
  /\ (ComputerDivision.mod (Int32.to_int year) 100 <> 0 \/ ComputerDivision.mod (Int32.to_int year) 400 = 0)

predicate common_year_has_three_hundred_sixty_five_calendar_days_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/time.rs" 1676 8 1676 109] (year: Int32.t) (outcome: bool) =
