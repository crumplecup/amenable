predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate year_is_non_negative_in_this_model [#"/home/erik/repos/amenable/crates/amenable_creusot/src/time.rs" 1598 8 1598 68] (year: Int32.t) =
