use creusot.int.Int32
use creusot.prelude.Any
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate interval_duration_is_non_negative_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/time.rs" 1394 8 1394 99] (start: Int32.t) (end': Int32.t) (outcome: bool) =
