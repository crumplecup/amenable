meta "rewrite_def" predicate ge_log_Int

predicate interval_duration_is_non_negative_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/time.rs" 970 8 970 99] (start: Int32.t) (end': Int32.t) (outcome: bool) =
