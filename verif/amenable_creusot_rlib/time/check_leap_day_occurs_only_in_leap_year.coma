predicate is_gregorian_leap_year [#"/home/erik/repos/amenable/crates/amenable_creusot/src/time.rs" 1383 8 1383 56] (year: Int32.t) =
  [%#stime'16] ComputerDivision.mod (Int32.to_int year) 4 = 0
  /\ (ComputerDivision.mod (Int32.to_int year) 100 <> 0 \/ ComputerDivision.mod (Int32.to_int year) 400 = 0)

predicate leap_day_occurs_only_in_leap_year_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/time.rs" 1586 8 1586 108] (year: Int32.t) (month: UInt8.t) (day: UInt8.t) (outcome: bool) =
  [%#stime'15] outcome = (not (UInt8.t'int month = 2 /\ UInt8.t'int day = 29) \/ is_gregorian_leap_year year)

