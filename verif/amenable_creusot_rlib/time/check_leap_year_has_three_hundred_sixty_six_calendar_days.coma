use int.ComputerDivision
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate is_gregorian_leap_year [#"/home/erik/repos/amenable/crates/amenable_creusot/src/time.rs" 1528 8 1528 56] (year: Int32.t) =
  [%#stime'15] ComputerDivision.mod (Int32.to_int year) 4 = 0
  /\ (ComputerDivision.mod (Int32.to_int year) 100 <> 0 \/ ComputerDivision.mod (Int32.to_int year) 400 = 0)

predicate leap_year_has_three_hundred_sixty_six_calendar_days_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/time.rs" 1548 8 1548 106] (year: Int32.t) (outcome: bool) =
  [%#stime'14] outcome = is_gregorian_leap_year year

