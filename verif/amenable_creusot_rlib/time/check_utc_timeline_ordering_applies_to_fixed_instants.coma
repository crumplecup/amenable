use int.Int

predicate utc_timeline_ordering_applies_to_fixed_instants_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/time.rs" 1181 8 1181 117] (earlier: Int32.t) (later: Int32.t) (outcome: bool) =
  [%#stime'5] outcome = (Int32.to_int earlier <= Int32.to_int later)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let check_utc_timeline_ordering_applies_to_fixed_instants [#"/home/erik/repos/amenable/crates/amenable_creusot/src/time.rs" 1206 8 1206 96]
  (a: Int32.t) (b: Int32.t) (c: Int32.t) (return (x: bool)) = (! bb0
  [ bb0 = s0 [ s0 = [ &_ret <- Int32.le a b ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l () | & a: Int32.t = a | & b: Int32.t = b ])
  [ return (result: bool) ->
  {[@stop_split] [@expl:check_utc_timeline_ordering_applies_to_fixed_instants ensures] ([@stop_split] [@expl:check_utc_timeline_ordering_applies_to_fixed_instants ensures #0] [%#stime'0] utc_timeline_ordering_applies_to_fixed_instants_holds a b result)
    /\ ([@stop_split] [@expl:check_utc_timeline_ordering_applies_to_fixed_instants ensures #1] [%#stime'1] utc_timeline_ordering_applies_to_fixed_instants_holds a a true)
    /\ ([@stop_split] [@expl:check_utc_timeline_ordering_applies_to_fixed_instants ensures #2] [%#stime'2] Int32.to_int a
        <= Int32.to_int b
      \/ Int32.to_int b <= Int32.to_int a)
    /\ ([@stop_split] [@expl:check_utc_timeline_ordering_applies_to_fixed_instants ensures #3] [%#stime'3] Int32.to_int a
          <= Int32.to_int b
        /\ Int32.to_int b <= Int32.to_int a -> Int32.to_int a = Int32.to_int b)
    /\ ([@stop_split] [@expl:check_utc_timeline_ordering_applies_to_fixed_instants ensures #4] [%#stime'4] Int32.to_int a
        <= Int32.to_int b
      /\ Int32.to_int b <= Int32.to_int c -> Int32.to_int a <= Int32.to_int c)}
    (! return {result}) ]
