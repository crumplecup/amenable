use creusot.int.UInt8
use creusot.prelude.Any

predicate ge_log_u8 [@inline:trivial] (self: UInt8.t) (other: UInt8.t) = [%#sord] UInt8.le other self

meta "rewrite_def" predicate ge_log_u8

predicate week_number_in_range_one_to_fifty_three_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/time.rs" 1208 8 1208 93] (week: UInt8.t) (outcome: bool) =
  [%#stime'4] outcome = (ge_log_u8 week (1: UInt8.t) /\ UInt8.lt week (54: UInt8.t))

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let check_week_number_in_range_one_to_fifty_three [#"/home/erik/repos/amenable/crates/amenable_creusot/src/time.rs" 1229 8 1229 74]
  (week: UInt8.t) (return (x: bool)) = (! bb0
  [ bb0 = s0
    [ s0 = [ &_5 <- UInt8.ge week ([%#stime] (1: UInt8.t)) ] s1
    | s1 = any [ br0 -> {_5 = false} (! bb2) | br1 -> {_5} (! bb1) ] ]
  | bb1 = s0 [ s0 = [ &_ret <- UInt8.le week ([%#stime'0] (53: UInt8.t)) ] s1 | s1 = return {_ret} ]
  | bb2 = s0 [ s0 = [ &_ret <- [%#stime'1] false ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l () | & week: UInt8.t = week | & _5: bool = Any.any_l () ])
  [ return (result: bool) ->
  {[@stop_split] [@expl:check_week_number_in_range_one_to_fifty_three ensures] [%#stime'3] week_number_in_range_one_to_fifty_three_holds week result}
    (! return {result}) ]
