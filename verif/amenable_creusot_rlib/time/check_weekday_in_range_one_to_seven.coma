let check_weekday_in_range_one_to_seven [#"/home/erik/repos/amenable/crates/amenable_creusot/src/time.rs" 1198 8 1198 67]
  (weekday: UInt8.t) (return (x: bool)) = (! bb0
  [ bb0 = s0
    [ s0 = [ &_5 <- UInt8.ge weekday ([%#stime] (1: UInt8.t)) ] s1
    | s1 = any [ br0 -> {_5 = false} (! bb2) | br1 -> {_5} (! bb1) ] ]
  | bb1 = s0 [ s0 = [ &_ret <- UInt8.le weekday ([%#stime'0] (7: UInt8.t)) ] s1 | s1 = return {_ret} ]
  | bb2 = s0 [ s0 = [ &_ret <- [%#stime'1] false ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l () | & weekday: UInt8.t = weekday | & _5: bool = Any.any_l () ])
  [ return (result: bool) ->
  {[@stop_split] [@expl:check_weekday_in_range_one_to_seven ensures] [%#stime'3] weekday_in_range_one_to_seven_holds weekday result}
    (! return {result}) ]
