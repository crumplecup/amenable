let%span sclock_bounds = "/home/erik/repos/amenable/crates/amenable_creusot/src/time/clock_bounds.rs" 269 22 269 26
let%span sclock_bounds'0 = "/home/erik/repos/amenable/crates/amenable_creusot/src/time/clock_bounds.rs" 266 19 266 23
let%span sclock_bounds'1 = "/home/erik/repos/amenable/crates/amenable_creusot/src/time/clock_bounds.rs" 267 18 267 74
let%span sclock_bounds'2 = "/home/erik/repos/amenable/crates/amenable_creusot/src/time/clock_bounds.rs" 247 24 247 50

use creusot.int.UInt8
use creusot.prelude.Any

predicate minute_in_range_zero_to_fifty_nine_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/time/clock_bounds.rs" 246 8 246 90] (minute: UInt8.t) (outcome: bool) =
  [%#sclock_bounds'2] outcome = UInt8.lt minute (60: UInt8.t)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let check_minute_in_range_zero_to_fifty_nine [#"/home/erik/repos/amenable/crates/amenable_creusot/src/time/clock_bounds.rs" 268 8 268 71]
  (minute: UInt8.t) (return (x: bool)) = (! bb0
  [ bb0 = s0 [ s0 = [ &_ret <- UInt8.le minute ([%#sclock_bounds] (59: UInt8.t)) ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l () | & minute: UInt8.t = minute ])
  [ return (result: bool) ->
  {[@stop_split] [@expl:check_minute_in_range_zero_to_fifty_nine ensures] [%#sclock_bounds'1] minute_in_range_zero_to_fifty_nine_holds minute result}
    (! return {result}) ]
