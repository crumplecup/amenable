(* #"/home/erik/repos/amenable/crates/amenable_creusot/src/time/clock_bounds.rs" 300 8 300 66 *)

let%span sclock_bounds = "/home/erik/repos/amenable/crates/amenable_creusot/src/time/clock_bounds.rs" 301 22 301 26
let%span sclock_bounds'0 = "/home/erik/repos/amenable/crates/amenable_creusot/src/time/clock_bounds.rs" 298 19 298 23
let%span sclock_bounds'1 = "/home/erik/repos/amenable/crates/amenable_creusot/src/time/clock_bounds.rs" 299 18 299 69
let%span sclock_bounds'2 = "/home/erik/repos/amenable/crates/amenable_creusot/src/time/clock_bounds.rs" 279 24 279 50

use creusot.int.UInt8
use creusot.prelude.Any

predicate second_in_range_zero_to_sixty_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/time/clock_bounds.rs" 278 8 278 85] (second: UInt8.t) (outcome: bool) =
  [%#sclock_bounds'2] outcome = UInt8.lt second (61: UInt8.t)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let check_second_in_range_zero_to_sixty [#"/home/erik/repos/amenable/crates/amenable_creusot/src/time/clock_bounds.rs" 300 8 300 66]
  (second: UInt8.t) (return (x: bool)) = (! bb0
  [ bb0 = s0 [ s0 = [ &_ret <- UInt8.le second ([%#sclock_bounds] (60: UInt8.t)) ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l () | & second: UInt8.t = second ])
  [ return (result: bool) ->
  {[@stop_split] [@expl:check_second_in_range_zero_to_sixty ensures] [%#sclock_bounds'1] second_in_range_zero_to_sixty_holds second result}
    (! return {result}) ]
