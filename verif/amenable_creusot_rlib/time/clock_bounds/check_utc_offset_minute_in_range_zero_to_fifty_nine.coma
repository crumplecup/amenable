let%span sclock_bounds = "/home/erik/repos/amenable/crates/amenable_creusot/src/time/clock_bounds.rs" 365 22 365 26
let%span sclock_bounds'0 = "/home/erik/repos/amenable/crates/amenable_creusot/src/time/clock_bounds.rs" 362 19 362 23
let%span sclock_bounds'1 = "/home/erik/repos/amenable/crates/amenable_creusot/src/time/clock_bounds.rs" 363 18 363 85
let%span sclock_bounds'2 = "/home/erik/repos/amenable/crates/amenable_creusot/src/time/clock_bounds.rs" 343 24 343 50

use creusot.int.UInt8
use creusot.prelude.Any

predicate utc_offset_minute_in_range_zero_to_fifty_nine_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/time/clock_bounds.rs" 342 8 342 101] (minute: UInt8.t) (outcome: bool) =
  [%#sclock_bounds'2] outcome = UInt8.lt minute (60: UInt8.t)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let check_utc_offset_minute_in_range_zero_to_fifty_nine [#"/home/erik/repos/amenable/crates/amenable_creusot/src/time/clock_bounds.rs" 364 8 364 82]
  (minute: UInt8.t) (return (x: bool)) = (! bb0
  [ bb0 = s0 [ s0 = [ &_ret <- UInt8.le minute ([%#sclock_bounds] (59: UInt8.t)) ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l () | & minute: UInt8.t = minute ])
  [ return (result: bool) ->
  {[@stop_split] [@expl:check_utc_offset_minute_in_range_zero_to_fifty_nine ensures] [%#sclock_bounds'1] utc_offset_minute_in_range_zero_to_fifty_nine_holds minute result}
    (! return {result}) ]
