  [ & _ret: bool = Any.any_l () | & a: Int32.t = a | & b: Int32.t = b ])
  [ return (result: bool) ->
  {[@stop_split] [@expl:check_utc_timeline_ordering_applies_to_fixed_instants ensures] ([@stop_split] [@expl:check_utc_timeline_ordering_applies_to_fixed_instants ensures #0] [%#sinterval_ordering'0] utc_timeline_ordering_applies_to_fixed_instants_holds a b result)
    /\ ([@stop_split] [@expl:check_utc_timeline_ordering_applies_to_fixed_instants ensures #1] [%#sinterval_ordering'1] utc_timeline_ordering_is_a_total_order_holds a b c)}
