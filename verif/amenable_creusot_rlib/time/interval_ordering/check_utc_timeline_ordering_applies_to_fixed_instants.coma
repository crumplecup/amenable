predicate utc_timeline_ordering_applies_to_fixed_instants_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/time/interval_ordering.rs" 203 8 203 117] (earlier: Int32.t) (later: Int32.t) (outcome: bool) =
  [%#sinterval_ordering'2] outcome = (Int32.to_int earlier <= Int32.to_int later)

predicate utc_timeline_ordering_is_a_total_order_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/time/interval_ordering.rs" 228 8 228 91] (a: Int32.t) (b: Int32.t) (c: Int32.t) =
  [%#sinterval_ordering'3] Int32.to_int a <= Int32.to_int a
  /\ (Int32.to_int a <= Int32.to_int b \/ Int32.to_int b <= Int32.to_int a)
  /\ (Int32.to_int a <= Int32.to_int b /\ Int32.to_int b <= Int32.to_int a -> Int32.to_int a = Int32.to_int b)
  /\ (Int32.to_int a <= Int32.to_int b /\ Int32.to_int b <= Int32.to_int c -> Int32.to_int a <= Int32.to_int c)

