predicate is_gregorian_leap_year [#"/home/erik/repos/amenable/crates/amenable_creusot/src/time/leap_year_core.rs" 326 8 326 56] (year: Int32.t) =
  [%#sleap_year_core'15] ComputerDivision.mod (Int32.to_int year) 4 = 0
  /\ (ComputerDivision.mod (Int32.to_int year) 100 <> 0 \/ ComputerDivision.mod (Int32.to_int year) 400 = 0)

predicate common_year_has_three_hundred_sixty_five_calendar_days_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/time/leap_year_core.rs" 401 8 401 109] (year: Int32.t) (outcome: bool) =
