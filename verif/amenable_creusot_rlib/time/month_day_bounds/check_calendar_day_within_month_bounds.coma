use creusot.int.UInt8
use creusot.int.Int32
use creusot.prelude.Bool
use creusot.prelude.Any
use int.ComputerDivision
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate month_in_range_one_to_twelve_for_requires [#"/home/erik/repos/amenable/crates/amenable_creusot/src/time/month_day_bounds.rs" 155 8 155 75] (month: UInt8.t) =
  [%#smonth_day_bounds'22] ge_log_Int (UInt8.t'int month) 1 /\ UInt8.t'int month <= 12

predicate is_gregorian_leap_year [#"/home/erik/repos/amenable/crates/amenable_creusot/src/time/leap_year_core.rs" 326 8 326 56] (year: Int32.t) =
  [%#sleap_year_core] ComputerDivision.mod (Int32.to_int year) 4 = 0
  /\ (ComputerDivision.mod (Int32.to_int year) 100 <> 0 \/ ComputerDivision.mod (Int32.to_int year) 400 = 0)

predicate calendar_day_within_month_bounds_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/time/month_day_bounds.rs" 213 8 213 107] (year: Int32.t) (month: UInt8.t) (day: UInt8.t) (outcome: bool) =
  [%#smonth_day_bounds'23] outcome
  = (ge_log_Int (UInt8.t'int day) 1
  /\ UInt8.t'int day
  <= (if UInt8.t'int month = 2 then
    if is_gregorian_leap_year year then 29 else 28
  else
    if UInt8.t'int month = 4 \/ UInt8.t'int month = 6 \/ UInt8.t'int month = 9 \/ UInt8.t'int month = 11 then 30 else 31
  ))

predicate valid_february_twenty_nine_forces_leap_year_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/time/month_day_bounds.rs" 243 8 248 17] (year: Int32.t) (month: UInt8.t) (day: UInt8.t) (valid: bool) =
  [%#smonth_day_bounds'24] UInt8.t'int month = 2 /\ UInt8.t'int day = 29 /\ valid -> is_gregorian_leap_year year

