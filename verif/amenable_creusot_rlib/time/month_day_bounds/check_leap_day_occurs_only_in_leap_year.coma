  /\ (ComputerDivision.mod (Int32.to_int year) 100 <> 0 \/ ComputerDivision.mod (Int32.to_int year) 400 = 0)

predicate leap_day_occurs_only_in_leap_year_holds [#"/home/erik/repos/amenable/crates/amenable_creusot/src/time/month_day_bounds.rs" 287 8 287 108] (year: Int32.t) (month: UInt8.t) (day: UInt8.t) (outcome: bool) =
